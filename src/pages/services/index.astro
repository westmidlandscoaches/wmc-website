---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageContainer from '../../components/ui/PageContainer.astro';
import Section from '../../components/ui/Section.astro';
import Button from '../../components/ui/Button.astro';
import PageHero from '../../components/content/PageHero.astro';
import { getCutout } from '../../data/fleetVisuals';
import airportTransfers from '../../assets/services/airport-transfers.webp';
import corporateTransport from '../../assets/services/corporate-transport.webp';
import privateGroupTransport from '../../assets/services/private-group-transport.webp';
import weddingTransport from '../../assets/services/wedding-transport.webp';
import schoolsEducation from '../../assets/services/schools-education.webp';
import dayTripsExcursions from '../../assets/services/day-trips-excursions.webp';

const heroVisual = getCutout('minibus-05')!;

const services = [
  {
    id: 'airport-transfers',
    title: 'Airport Transfers',
    copy: 'Transport organised around flight times, terminals and passenger numbers, for individual travellers or groups.',
    image: airportTransfers,
    alt: 'Chauffeur-driven car waiting on an airport apron as an aircraft comes in to land',
  },
  {
    id: 'corporate-transport',
    title: 'Corporate Transport',
    copy: 'Transport for staff, clients or business events, organised around the schedule of the day.',
    image: corporateTransport,
    alt: 'Business colleagues talking together in a hotel lobby before travelling',
  },
  {
    id: 'private-group-transport',
    title: 'Private Group Transport',
    copy: 'Transport for private groups travelling together, matched to passenger numbers and the route required.',
    image: privateGroupTransport,
    alt: 'A group of friends together at a viewpoint at the end of a journey',
  },
  {
    id: 'wedding-transport',
    title: 'Wedding Transport',
    copy: 'Transport organised around the timing and party of a wedding day.',
    image: weddingTransport,
    alt: 'Bride and groom walking to a decorated chauffeur car outside a church',
  },
  {
    id: 'schools-education',
    title: 'Schools & Education',
    copy: 'Transport for school and education groups, organised around timing, numbers and destination.',
    image: schoolsEducation,
    alt: 'A large group of students celebrating together outside a college building',
  },
  {
    id: 'day-trips-excursions',
    title: 'Day Trips & Excursions',
    copy: 'Transport for day trips and group excursions, organised around the itinerary.',
    image: dayTripsExcursions,
    alt: 'A WMC-style minibus parked on a coastal road above the sea',
  },
];
---

<BaseLayout
  title="Services | West Midlands Coaches"
  description="Airport transfers, corporate transport, private group transport, wedding transport, schools and education, and day trips organised by West Midlands Coaches."
  path="/services/"
>
  <PageHero
    priority
    eyebrow="Services"
    breadcrumb={[{ label: 'Home', href: '/' }, { label: 'Services' }]}
    title="Transport organised around the journey."
    lead="WMC provides driver-operated Cars, Minibuses and Coaches for airport, corporate, private group and other verified passenger-transport requirements."
    primaryCta={{ label: 'Request a Quote', href: '/request-a-quote/' }}
    image={heroVisual.image}
    imageAlt={heroVisual.alt}
    cutout
    caption="WMC minibus fleet"
  />

  <Section as="div" surface="heritage-ivory">
    <PageContainer>
      <div class="services">
        {services.map((service) => (
          <article id={service.id} class="service-card">
            <div class="service-card__media">
              {service.image ? (
                <Image
                  src={service.image}
                  alt={service.alt}
                  widths={[480, 760, 1100]}
                  sizes="(min-width: 1024px) 46vw, (min-width: 640px) 60vw, 100vw"
                  loading="lazy"
                  class="service-card__image"
                />
              ) : (
                /* Branded stand-in until WMC supplies photography for this
                   service. Never another service's picture. */
                <p class="service-card__placeholder">
                  <span class="service-card__placeholder-mark" aria-hidden="true">WMC</span>
                  Service image being updated
                </p>
              )}
            </div>

            <div class="service-card__body">
              <h2 class="text-h4 service-card__title">{service.title}</h2>
              <p class="text-body service-card__copy">{service.copy}</p>
              <div class="service-card__action">
                <Button href="/request-a-quote/" variant="secondary">Request a Quote</Button>
                <span class="service-card__arrow" aria-hidden="true">&#8594;</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </PageContainer>
  </Section>
</BaseLayout>

<style>
  .services {
    display: grid;
    gap: var(--space-3);
  }

  .service-card {
    display: flex;
    flex-direction: column;
    min-inline-size: 0;
    scroll-margin-block-start: calc(var(--header-offset) + var(--space-3));
    background-color: var(--color-warm-white);
    border: var(--border-width-hairline) solid var(--color-linen-border);
    border-radius: var(--radius-panel);
    overflow: hidden;
    transition:
      border-color 300ms var(--motion-easing-premium),
      box-shadow 300ms var(--motion-easing-premium),
      transform 300ms var(--motion-easing-premium);
  }

  .service-card__media {
    position: relative;
    display: flex;
    overflow: hidden;
    background-color: var(--color-graphite-surface);
  }

  .service-card__media :global(.service-card__image) {
    inline-size: 100%;
    block-size: 190px;
    object-fit: cover;
    transition: transform 380ms var(--motion-easing-premium);
  }

  /* A hairline of gold along the base of the photograph, drawn in on hover. */
  .service-card__media::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    block-size: 2px;
    background-color: var(--color-champagne-gold);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 320ms var(--motion-easing-premium);
  }

  .service-card__placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    inline-size: 100%;
    block-size: 190px;
    margin: 0;
    padding: var(--space-3);
    text-align: center;
    color: var(--color-heritage-ivory);
    font-size: var(--text-small);
    line-height: var(--leading-small);
  }

  .service-card__placeholder-mark {
    font-size: var(--text-h4);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.16em;
    color: var(--color-champagne-gold);
  }

  .service-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--space-3);
  }

  .service-card__title {
    margin: 0 0 var(--space-1);
    color: var(--color-obsidian);
  }

  .service-card__copy {
    margin: 0 0 var(--space-3);
    color: var(--color-slate-taupe);
    max-inline-size: 52ch;
  }

  .service-card__action {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-block-start: auto;
  }

  .service-card__arrow {
    color: var(--color-champagne-gold);
    transition: transform 280ms var(--motion-easing-premium);
  }

  /* Pointer devices only: touch keeps every card at its resting state, with
     nothing hidden behind a hover it cannot perform. */
  @media (hover: hover) and (pointer: fine) {
    .service-card:hover {
      transform: translateY(-3px);
      border-color: var(--color-mist-taupe);
      box-shadow: var(--shadow-raised);
    }

    .service-card:hover .service-card__media :global(.service-card__image) {
      transform: scale(1.03);
    }

    .service-card:hover .service-card__media::after,
    .service-card:focus-within .service-card__media::after {
      transform: scaleX(1);
    }

    .service-card:hover .service-card__arrow {
      transform: translateX(4px);
    }
  }

  .service-card:focus-within {
    border-color: var(--color-champagne-gold);
  }

  /* Small phones: the shortest band, so a card stays well inside a screenful. */
  @media (max-width: 479px) {
    .service-card__media :global(.service-card__image),
    .service-card__placeholder {
      block-size: 180px;
    }
  }

  /* Tablet: two columns as soon as there is room for them. */
  @media (min-width: 640px) {
    .services {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-3);
    }

    .service-card__media :global(.service-card__image),
    .service-card__placeholder {
      block-size: 200px;
    }

    .service-card__body {
      padding: var(--space-3);
    }
  }

  /* Desktop: three across. Rows stretch to a shared height so the cards in a
     row stay equal whatever the copy length. */
  @media (min-width: 1024px) {
    .services {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-auto-rows: 1fr;
      gap: var(--space-3);
    }

    /* Roughly 16:9 across a third of the grid, capped so the band cannot
       grow with the viewport. */
    .service-card__media :global(.service-card__image),
    .service-card__placeholder {
      block-size: clamp(180px, 12vw, 210px);
    }

    .service-card__body {
      padding: var(--space-3);
    }
  }

  @media (min-width: 1280px) {
    .services {
      gap: var(--space-4);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-card,
    .service-card__media :global(.service-card__image),
    .service-card__media::after,
    .service-card__arrow {
      transition-duration: 0.01ms;
    }
  }
</style>
