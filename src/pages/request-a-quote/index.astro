---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageContainer from '../../components/ui/PageContainer.astro';
import Section from '../../components/ui/Section.astro';
import Button from '../../components/ui/Button.astro';
import PageHero from '../../components/content/PageHero.astro';
import QuoteRequestForm from '../../components/forms/QuoteRequestForm.astro';
import { contact } from '../../data/navigation';
import { getCutout } from '../../data/fleetVisuals';

const heroVisual = getCutout('car-03')!;
---

<BaseLayout
  title="Request a Quote | West Midlands Coaches"
  description="Share the route, timing, passenger numbers and requirements so West Midlands Coaches can prepare a bespoke quotation."
  path="/request-a-quote/"
>
  <PageHero
    priority
    eyebrow="Bespoke quotation"
    breadcrumb={[{ label: 'Home', href: '/' }, { label: 'Request a Quote' }]}
    title="Tell us about your journey."
    lead="Share the route, timing, passenger numbers and requirements so WMC can prepare a bespoke quotation."
    primaryCta={{ label: `Call ${contact.phoneDisplay}`, href: contact.phoneHref }}
    secondaryCta={{ label: 'WhatsApp', href: contact.whatsappHref }}
    image={heroVisual.image}
    imageAlt={heroVisual.alt}
    cutout
    caption="WMC chauffeur car fleet"
    detail={['Driver-operated', 'Cars, Minibuses & Coaches', 'Birmingham & the West Midlands']}
  />

  <Section as="div" surface="heritage-ivory">
    <PageContainer>
      <QuoteRequestForm />
    </PageContainer>
  </Section>

  <Section as="div" surface="warm-white">
    <PageContainer>
      <div class="quote-intro">
        <p class="eyebrow">Prefer to speak to someone</p>
        <p class="text-body-large quote-intro__copy">
          WMC reviews the journey details and prepares a quotation around them. To start the
          conversation today, call or message WMC directly.
        </p>
        <div class="quote-actions">
          <Button href={contact.phoneHref} variant="primary">Call {contact.phoneDisplay}</Button>
          <Button href={contact.whatsappHref} variant="secondary">WhatsApp</Button>
        </div>
      </div>
    </PageContainer>
  </Section>
</BaseLayout>

<style is:global>
  /* Keeps the floating contact control clear of the form's step buttons on
     narrow screens, without removing it from this page. */
  @media (max-width: 767px) {
    :root {
      --fab-offset-block-end: 56px;
    }
  }
</style>

<style>
  .quote-intro {
    max-inline-size: 56ch;
  }

  .quote-intro__copy {
    color: var(--color-ink);
    margin: 0;
  }

  .quote-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block-start: var(--space-4);
  }

  @media (max-width: 479px) {
    .quote-actions {
      gap: 12px;
    }

    .quote-actions :global(.wmc-button) {
      inline-size: 100%;
    }
  }
</style>
