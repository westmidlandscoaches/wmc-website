---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageContainer from '../components/ui/PageContainer.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import FaqAccordion from '../components/content/FaqAccordion.astro';
import HomeHero from '../components/content/HomeHero.astro';
import FeaturedFleet, { type FeaturedFleetItem } from '../components/fleet/FeaturedFleet.tsx';
import { getFleetVisuals } from '../data/fleetVisuals';
import { contact } from '../data/navigation';

const carPanel = getFleetVisuals('car', 'exterior')[0];
const minibusPanel = getFleetVisuals('minibus', 'exterior').find((v) => v.id === 'minibus-05-exterior-01')!;
const coachPanel = getFleetVisuals('coach', 'exterior').find((v) => v.id === 'coach-02-exterior-01')!;
const serviceFeatureImage = getFleetVisuals('minibus', 'exterior').find((v) => v.id === 'minibus-04-exterior')!;
const ctaImage = getFleetVisuals('minibus', 'exterior').find((v) => v.id === 'minibus-01-exterior')!;

const fleetCards = [
  {
    href: '/fleet/#cars',
    label: 'Cars',
    copy: 'Chauffeur-driven transport for individual and smaller-party requirements.',
    visual: carPanel,
  },
  {
    href: '/fleet/#minibuses',
    label: 'Minibuses',
    copy: 'Group transport for journeys that require more passenger capacity.',
    visual: minibusPanel,
  },
  {
    href: '/fleet/#coaches',
    label: 'Coaches',
    copy: 'Larger-group passenger transport.',
    visual: coachPanel,
  },
];

const proofPoints = [
  { label: 'Operating since', value: 'Established 2014' },
  { label: 'Fleet', value: '14 WMC-owned vehicles' },
  { label: 'Categories', value: 'Cars, Minibuses & Coaches' },
  { label: 'Operation', value: 'Driver-operated transport' },
];

const journeyConcerns = [
  { title: 'Passengers', copy: 'How many people are travelling, and together or in groups.' },
  { title: 'Luggage', copy: 'What is travelling with them, and the space it needs.' },
  { title: 'Timing', copy: 'When the journey starts, and what it has to meet.' },
  { title: 'Stops', copy: 'Where the journey collects, pauses and finishes.' },
  { title: 'Appropriate transport', copy: 'Which vehicle actually suits all of the above.' },
];

const supportingServices = [
  { href: '/services/#corporate-transport', title: 'Corporate Transport', copy: 'Staff, client and business event travel.' },
  { href: '/services/#private-group-transport', title: 'Private Group Transport', copy: 'Groups travelling together, one arrangement.' },
  { href: '/services/#wedding-transport', title: 'Wedding Transport', copy: 'Organised around the timing of the day.' },
  { href: '/services/#schools-education', title: 'Schools & Education', copy: 'Education groups, timing and numbers.' },
  { href: '/services/#day-trips-excursions', title: 'Day Trips & Excursions', copy: 'Transport built around the itinerary.' },
];

const organisePillars = [
  {
    index: '01',
    title: 'Appropriate transport',
    copy: 'The vehicle is matched to passenger numbers, luggage and the nature of the journey.',
  },
  {
    index: '02',
    title: 'Proper organisation',
    copy: 'Route, timing and stops are considered as part of preparing the journey, not left to chance.',
  },
  {
    index: '03',
    title: 'Clear quotation',
    copy: 'A bespoke quotation is prepared around the specific details of the journey.',
  },
];

const quoteSteps = [
  { index: '01', title: 'Tell us about the journey', copy: 'Where, when and who is travelling.' },
  { index: '02', title: 'Tell us what you need', copy: 'Passengers, luggage and vehicle preference.' },
  { index: '03', title: 'WMC reviews the request', copy: 'The information is used to prepare a bespoke quotation.' },
];

const featuredSource: { category: FeaturedFleetItem['category']; label: string; copy: string }[] = [
  { category: 'car', label: 'Cars', copy: 'Chauffeur-driven transport for individual and smaller-party requirements.' },
  { category: 'minibus', label: 'Minibuses', copy: 'Group transport for journeys that require more passenger capacity.' },
  { category: 'coach', label: 'Coaches', copy: 'Larger-group passenger transport.' },
];

const featuredItems: FeaturedFleetItem[] = await Promise.all(
  featuredSource.map(async ({ category, label, copy }) => {
    const visual =
      getFleetVisuals(category, 'exterior').find((v) => v.homepageFeatured) ??
      getFleetVisuals(category, 'exterior')[0];
    const optimised = await getImage({ src: visual.image, width: 1400 });
    return {
      category,
      label,
      copy,
      href: `/fleet/#${category === 'car' ? 'cars' : category === 'minibus' ? 'minibuses' : 'coaches'}`,
      src: optimised.src,
      width: optimised.attributes.width as number,
      height: optimised.attributes.height as number,
      alt: visual.alt,
    };
  }),
);

const faqItems = [
  {
    question: 'Is WMC transport driver-operated?',
    answer: 'Yes. All WMC vehicles are driver-operated; self-drive hire is not offered.',
  },
  {
    question: 'What information do I need for a quotation?',
    answer:
      'The route, dates and times, and the number of passengers travelling. The more detail you can provide about the journey, the more accurate the quotation.',
  },
  {
    question: 'What if I do not know which vehicle I need?',
    answer:
      'Tell us about the journey and passenger numbers and WMC will recommend suitable transport as part of preparing your quotation.',
  },
  {
    question: 'Can I request a particular vehicle?',
    answer: 'Yes, you can note a preference when requesting a quotation and WMC will confirm availability.',
  },
  {
    question: 'Does WMC provide airport transport?',
    answer: 'Yes, airport transfers are one of the journeys WMC organises. See Services for more detail.',
  },
];
---

<BaseLayout
  title="West Midlands Coaches | Coach, Minibus & Chauffeur Hire"
  description="Coach, Minibus & Chauffeur-Driven Car Hire in Birmingham and the West Midlands, organised around the people, route and requirements of each journey."
  path="/"
>
  <!-- 1. HERO -->
  <HomeHero />

  <!-- 2. VERIFIED PROOF -->
  <Section as="div" surface="heritage-ivory">
    <PageContainer>
      <ul class="proof">
        {proofPoints.map((point) => (
          <li class="proof__item">
            <span class="proof__label">{point.label}</span>
            <span class="proof__value text-h6">{point.value}</span>
          </li>
        ))}
      </ul>
    </PageContainer>
  </Section>

  <!-- 3. JOURNEY PROBLEM -->
  <Section as="div" surface="warm-white">
    <PageContainer>
      <div class="problem">
        <div class="problem__narrative">
          <p class="eyebrow">The brief behind every booking</p>
          <h2 data-reveal>A journey involves more than choosing a vehicle.</h2>
          <hr class="journey-line problem__line" data-journey-line aria-hidden="true" />
          <p class="text-body-large problem__statement">
            WMC organises the journey, not just the vehicle.
          </p>
        </div>

        <ul class="problem__list">
          {journeyConcerns.map((concern, index) => (
            <li class="card problem__row" data-reveal style={`--reveal-delay:${index * 60}ms`}>
              <span class="problem__marker" aria-hidden="true"></span>
              <div>
                <h3 class="text-h6 problem__row-title">{concern.title}</h3>
                <p class="text-small problem__row-copy">{concern.copy}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </PageContainer>
  </Section>

  <!-- 4. REAL WMC FLEET -->
  <Section as="div" surface="heritage-ivory">
    <PageContainer>
      <header class="section-head">
        <p class="eyebrow">The fleet</p>
        <h2 class="section-head__title">Find the transport that fits the journey.</h2>
      </header>

      <div class="fleet-grid">
        {fleetCards.map((card, index) => (
          <a class="card card--media fleet-card" href={card.href} data-reveal style={`--reveal-delay:${index * 70}ms`}>
            <div class="card__media fleet-card__media">
              <Image
                src={card.visual.image}
                alt={card.visual.alt}
                widths={[420, 640, 900]}
                sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
                loading="lazy"
                class="fleet-card__image"
              />
            </div>
            <div class="card__body fleet-card__body">
              <h3 class="text-h4 fleet-card__title">{card.label}</h3>
              <p class="text-body fleet-card__copy">{card.copy}</p>
              <span class="arrow-link fleet-card__action">Explore</span>
            </div>
          </a>
        ))}
      </div>
    </PageContainer>
  </Section>

  <!-- 5. SERVICE DISCOVERY -->
  <Section as="div" surface="night-graphite">
    <PageContainer>
      <header class="section-head">
        <p class="eyebrow eyebrow--dark">Services</p>
        <h2 class="section-head__title section-head__title--dark">What are you organising?</h2>
      </header>

      <div class="services">
        <a class="card card--dark card--media service-feature" href="/services/#airport-transfers" data-reveal>
          <div class="card__media service-feature__media">
            <Image
              src={serviceFeatureImage.image}
              alt={serviceFeatureImage.alt}
              widths={[480, 760, 1100]}
              sizes="(min-width: 1024px) 42vw, 100vw"
              loading="lazy"
              class="service-feature__image"
            />
          </div>
          <div class="card__body service-feature__body">
            <span class="service__index">01</span>
            <h3 class="text-h3 service-feature__title">Airport Transfers</h3>
            <p class="text-body service-feature__copy">
              Transport organised around flight times, terminals and passenger numbers.
            </p>
            <span class="arrow-link arrow-link--dark">Explore</span>
          </div>
        </a>

        <ul class="service-list">
          {supportingServices.map((service, index) => (
            <li data-reveal style={`--reveal-delay:${(index + 1) * 55}ms`}>
              <a class="card card--dark service-row" href={service.href}>
                <span class="service__index">{String(index + 2).padStart(2, '0')}</span>
                <span class="service-row__text">
                  <span class="text-h6 service-row__title">{service.title}</span>
                  <span class="text-small service-row__copy">{service.copy}</span>
                </span>
                <span class="service-row__arrow" aria-hidden="true">&#8594;</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </PageContainer>
  </Section>

  <!-- 6. HOW WMC ORGANISES IT -->
  <Section as="div" surface="warm-white">
    <PageContainer>
      <header class="section-head">
        <p class="eyebrow">The approach</p>
        <h2 class="section-head__title">How WMC organises it.</h2>
      </header>

      <div class="organise">
        {organisePillars.map((pillar, index) => (
          <article class="organise__item" data-reveal style={`--reveal-delay:${index * 80}ms`}>
            <span class="organise__index" aria-hidden="true">{pillar.index}</span>
            <hr class="organise__rule" aria-hidden="true" />
            <h3 class="text-h4 organise__title">{pillar.title}</h3>
            <p class="text-body organise__copy">{pillar.copy}</p>
          </article>
        ))}
      </div>
    </PageContainer>
  </Section>

  <!-- 7. FEATURED FLEET EXPERIENCE -->
  <Section as="div" surface="heritage-ivory">
    <PageContainer>
      <header class="section-head">
        <p class="eyebrow">Fleet in detail</p>
        <h2 class="section-head__title">Real vehicles, photographed as they are.</h2>
      </header>
      <FeaturedFleet client:idle items={featuredItems} />
    </PageContainer>
  </Section>

  <!-- 8. QUOTE PROCESS -->
  <Section as="div" surface="obsidian">
    <PageContainer>
      <header class="section-head">
        <p class="eyebrow eyebrow--dark">The process</p>
        <h2 class="section-head__title section-head__title--dark">From journey details to quotation.</h2>
      </header>

      <ol class="quote-steps">
        {quoteSteps.map((step, index) => (
          <li class="card card--dark quote-step" data-reveal style={`--reveal-delay:${index * 80}ms`}>
            <span class="quote-step__index" aria-hidden="true">{step.index}</span>
            <h3 class="text-h5 quote-step__title">{step.title}</h3>
            <p class="text-body quote-step__copy">{step.copy}</p>
          </li>
        ))}
      </ol>
    </PageContainer>
  </Section>

  <!-- 10. FAQ -->
  <Section as="div" surface="warm-white">
    <PageContainer>
      <div class="faq">
        <header class="faq__head">
          <p class="eyebrow">Questions</p>
          <h2 class="section-head__title">Questions about organising your journey.</h2>
        </header>
        <div class="faq__body">
          <FaqAccordion items={faqItems} />
        </div>
      </div>
    </PageContainer>
  </Section>

  <!-- 11. FINAL CTA -->
  <section class="final-cta">
    <PageContainer>
      <div class="final-cta__grid">
        <div class="final-cta__copy">
          <p class="eyebrow eyebrow--dark">Request a quotation</p>
          <h2 class="text-h2 final-cta__heading">Tell us about your journey.</h2>
          <p class="text-lead final-cta__lead">
            Provide the route, passengers and requirements and WMC can prepare a quotation around the journey.
          </p>
          <div class="final-cta__actions">
            <Button href="/request-a-quote/" variant="primary" tone="dark">Request a Quote</Button>
            <Button href={contact.phoneHref} variant="secondary" tone="dark">Call {contact.phoneDisplay}</Button>
            <Button href={contact.whatsappHref} variant="secondary" tone="dark">WhatsApp</Button>
          </div>
        </div>

        <div class="final-cta__media">
          <Image
            src={ctaImage.image}
            alt={ctaImage.alt}
            widths={[480, 760, 1100]}
            sizes="(min-width: 1024px) 44vw, 100vw"
            loading="lazy"
            class="final-cta__image"
          />
        </div>
      </div>
    </PageContainer>
  </section>
</BaseLayout>

<style>
  /* ------------------------------ Proof ----------------------------- */
  .proof {
    display: grid;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .proof__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-inline-start: var(--space-3);
    border-inline-start: 2px solid var(--gold-rule);
  }

  .proof__label {
    font-size: var(--text-small);
    line-height: var(--leading-small);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: var(--font-weight-semibold);
    color: var(--color-slate-taupe);
  }

  .proof__value {
    color: var(--color-obsidian);
    font-weight: var(--font-weight-semibold);
  }

  @media (min-width: 768px) {
    .proof {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-5);
    }
  }

  /* ----------------------------- Problem ---------------------------- */
  .problem {
    display: grid;
    gap: var(--space-6);
  }

  .problem__narrative h2 {
    margin-block: 0 var(--space-4);
    max-inline-size: 20ch;
    text-wrap: balance;
  }

  .problem__line {
    margin-block-end: var(--space-4);
    max-inline-size: 180px;
  }

  .problem__statement {
    color: var(--color-obsidian);
    font-weight: var(--font-weight-semibold);
    max-inline-size: 34ch;
    margin: 0;
  }

  .problem__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .problem__row {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-3);
    background-color: transparent;
  }

  @media (hover: hover) and (pointer: fine) {
    .problem__row:hover {
      border-color: var(--color-mist-taupe);
      background-color: var(--surface-tint-light);
    }
  }

  .problem__marker {
    inline-size: 6px;
    block-size: 6px;
    margin-block-start: 9px;
    border-radius: 50%;
    background-color: var(--color-champagne-gold);
    flex-shrink: 0;
  }

  .problem__row-title {
    margin: 0 0 2px;
  }

  .problem__row-copy {
    margin: 0;
    color: var(--color-slate-taupe);
  }

  @media (min-width: 1024px) {
    .problem {
      grid-template-columns: 5fr 6fr;
      gap: var(--space-8);
      align-items: start;
    }
  }

  /* --------------------------- Section head ------------------------- */
  .section-head {
    margin-block-end: var(--space-6);
  }

  .section-head__title {
    margin: 0;
    max-inline-size: 24ch;
    text-wrap: balance;
  }

  .section-head__title--dark {
    color: var(--color-warm-white);
  }

  /* ------------------------------ Fleet ----------------------------- */
  .fleet-grid {
    display: grid;
    gap: var(--space-3);
  }

  .fleet-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--color-ink);
  }

  .fleet-card__media :global(.fleet-card__image) {
    aspect-ratio: 4 / 3;
  }

  .fleet-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-3);
    flex: 1;
  }

  .fleet-card__title {
    margin: 0;
  }

  .fleet-card__copy {
    color: var(--color-slate-taupe);
    margin: 0 0 var(--space-2);
    flex: 1;
  }

  .fleet-card__action {
    margin-block-start: auto;
  }

  @media (min-width: 600px) {
    .fleet-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-4);
    }
  }

  /* Three across only once each card still has room to breathe. */
  @media (min-width: 1024px) {
    .fleet-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* ---------------------------- Services ---------------------------- */
  .services {
    display: grid;
    gap: var(--space-4);
  }

  .service-feature {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--color-warm-white);
  }

  .service-feature__media :global(.service-feature__image) {
    aspect-ratio: 16 / 10;
  }

  .service-feature__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4);
    flex: 1;
  }

  .service-feature__title {
    margin: 0;
    color: var(--color-warm-white);
  }

  .service-feature__copy {
    color: var(--color-mist-taupe);
    margin: 0 0 var(--space-3);
  }

  .service__index {
    font-size: var(--text-small);
    letter-spacing: 0.12em;
    font-weight: var(--font-weight-semibold);
    color: var(--color-champagne-gold);
  }

  .service-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .service-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3);
    min-block-size: var(--touch-target-min);
    text-decoration: none;
    color: var(--color-warm-white);
    background-color: transparent;
  }

  .service-row__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
  }

  .service-row__title {
    color: var(--color-warm-white);
    font-weight: var(--font-weight-semibold);
  }

  .service-row__copy {
    color: var(--color-mist-taupe);
  }

  .service-row__arrow {
    color: var(--color-champagne-gold);
    transition: transform var(--motion-hover) var(--motion-easing-premium);
  }

  @media (hover: hover) and (pointer: fine) {
    .service-row:hover {
      background-color: var(--surface-tint-dark);
      border-color: var(--gold-rule);
      transform: none;
      box-shadow: none;
    }

    .service-row:hover .service-row__arrow {
      transform: translateX(4px);
    }
  }

  @media (min-width: 1024px) {
    .services {
      grid-template-columns: 5fr 6fr;
      gap: var(--space-5);
      align-items: start;
    }
  }

  /* ---------------------------- Organise ---------------------------- */
  .organise {
    display: grid;
    gap: var(--space-6);
  }

  .organise__index {
    display: block;
    font-size: clamp(2.5rem, 2rem + 2vw, 3.75rem);
    line-height: 1;
    font-weight: var(--font-weight-bold);
    color: var(--color-linen-border);
  }

  .organise__rule {
    inline-size: 44px;
    block-size: 1px;
    border: 0;
    background-color: var(--gold-rule-strong);
    margin: var(--space-2) 0 var(--space-3);
  }

  .organise__title {
    margin: 0 0 var(--space-2);
  }

  .organise__copy {
    color: var(--color-slate-taupe);
    margin: 0;
    max-inline-size: 40ch;
  }

  @media (min-width: 900px) {
    .organise {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-5);
    }

    /* Slight vertical stagger keeps the row from reading as three boxes. */
    .organise__item:nth-child(2) {
      margin-block-start: var(--space-5);
    }

    .organise__item:nth-child(3) {
      margin-block-start: var(--space-9);
    }
  }

  /* -------------------------- Quote process ------------------------- */
  .quote-steps {
    display: grid;
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: none;
  }

  .quote-step {
    position: relative;
    padding: var(--space-4);
  }

  .quote-step__index {
    display: block;
    font-size: var(--text-h4);
    line-height: 1;
    font-weight: var(--font-weight-bold);
    color: var(--color-champagne-gold);
    margin-block-end: var(--space-3);
  }

  .quote-step__title {
    color: var(--color-warm-white);
    margin: 0 0 var(--space-1);
  }

  .quote-step__copy {
    color: var(--color-mist-taupe);
    margin: 0;
  }

  @media (hover: hover) and (pointer: fine) {
    .quote-step:hover {
      border-color: var(--gold-rule);
    }
  }

  @media (min-width: 1024px) {
    .quote-steps {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-4);
    }

    /* Hairline connector between the three panels. */
    .quote-step + .quote-step::before {
      content: '';
      position: absolute;
      inset-block-start: calc(var(--space-4) + 0.5em);
      inset-inline-start: calc(var(--space-4) * -1);
      inline-size: var(--space-4);
      block-size: 1px;
      background-color: var(--color-charcoal-border);
    }
  }

  /* ------------------------------- FAQ ------------------------------ */
  .faq {
    display: grid;
    gap: var(--space-5);
  }

  .faq__head .section-head__title {
    max-inline-size: 18ch;
  }

  @media (min-width: 1024px) {
    .faq {
      grid-template-columns: 4fr 7fr;
      gap: var(--space-8);
      align-items: start;
    }
  }

  /* ---------------------------- Final CTA --------------------------- */
  .final-cta {
    background-color: var(--color-obsidian);
    color: var(--color-warm-white);
  }

  .final-cta__grid {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-8);
    align-items: center;
  }

  .final-cta__heading {
