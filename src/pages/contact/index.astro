---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageContainer from '../../components/ui/PageContainer.astro';
import Section from '../../components/ui/Section.astro';
import Button from '../../components/ui/Button.astro';
import PageHero from '../../components/content/PageHero.astro';
import { contact } from '../../data/navigation';
import { getFleetVisuals } from '../../data/fleetVisuals';

const heroVisual = getFleetVisuals('car', 'exterior').find((v) => v.id === 'car-02-exterior')!;
---

<BaseLayout
  title="Contact | West Midlands Coaches"
  description="Contact West Midlands Coaches by phone or WhatsApp to discuss a journey, or request a quotation."
  path="/contact/"
>
  <PageHero
    priority
    eyebrow="Contact"
    breadcrumb={[{ label: 'Home', href: '/' }, { label: 'Contact' }]}
    title="Talk to WMC about your journey."
    lead="Speak directly with West Midlands Coaches about a journey, transport requirement or quotation."
    primaryCta={{ label: `Call ${contact.phoneDisplay}`, href: contact.phoneHref }}
    secondaryCta={{ label: 'WhatsApp', href: contact.whatsappHref }}
    tertiaryCta={{ label: 'Request a Quote', href: '/request-a-quote/' }}
    image={heroVisual.image}
    imageAlt={heroVisual.alt}
    caption="WMC-owned fleet"
  />

  <Section as="div" surface="warm-white">
    <PageContainer>
      <div class="contact-details">
        <div>
          <h2 class="text-h5">Phone</h2>
          <a class="text-body-large" href={contact.phoneHref}>{contact.phoneDisplay}</a>
        </div>
        <div>
          <h2 class="text-h5">WhatsApp</h2>
          <a class="text-body-large" href={contact.whatsappHref}>Message WMC on WhatsApp</a>
        </div>
        <div>
          <h2 class="text-h5">Address</h2>
          <p class="text-body-large">{contact.address}</p>
        </div>
      </div>

      <div class="contact-actions">
        <Button href="/request-a-quote/" variant="primary">Request a Quote</Button>
        <Button href={contact.phoneHref} variant="secondary">Call {contact.phoneDisplay}</Button>
      </div>
    </PageContainer>
  </Section>
</BaseLayout>

<style>
  .contact-details {
    display: grid;
    gap: var(--space-4);
    margin-block-end: var(--space-6);
  }

  .contact-details a {
    text-decoration: none;
    color: var(--color-obsidian);
  }

  .contact-details p {
    margin: 0;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  @media (min-width: 768px) {
    .contact-details {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
