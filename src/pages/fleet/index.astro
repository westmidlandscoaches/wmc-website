---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageContainer from '../../components/ui/PageContainer.astro';
import Section from '../../components/ui/Section.astro';
import Button from '../../components/ui/Button.astro';
import PageHero from '../../components/content/PageHero.astro';
import { getCutout } from '../../data/fleetVisuals';
import {
  fleetSlots,
  vehicleLabel,
  FLEET_TOTAL,
  type FleetVehicle,
  type VehicleCategory,
} from '../../data/fleet';

const heroVisual = getCutout('coach-01')!;

const confirmedVehicles: FleetVehicle[] = fleetSlots();

const categories: {
  id: string;
  category: VehicleCategory;
  title: string;
  singular: string;
  copy: string;
}[] = [
  {
    id: 'cars',
    category: 'car',
    title: 'Cars',
    singular: 'Car',
    copy: 'Chauffeur-driven transport for individual and smaller-party requirements.',
  },
  {
    id: 'minibuses',
    category: 'minibus',
    title: 'Minibuses',
    singular: 'Minibus',
    copy: 'Group transport for journeys that require more passenger capacity.',
  },
  {
    id: 'coaches',
    category: 'coach',
    title: 'Coaches',
    singular: 'Coach',
    copy: 'Larger-group passenger transport.',
  },
];

const sections = categories.map((category) => ({
  ...category,
  vehicles: confirmedVehicles.filter((vehicle) => vehicle.category === category.category),
}));

/** Prefills the quotation form with everything already known about a vehicle. */
const quoteHref = (vehicle: FleetVehicle) =>
  `/request-a-quote/?fleet=${vehicle.category}&service=${vehicle.serviceLevel.toLowerCase()}&vehicle=${vehicle.id}`;
---

<BaseLayout
  title="Fleet | West Midlands Coaches"
  description="Cars, Minibuses and Coaches in the WMC-owned fleet, serving Birmingham and the West Midlands."
  path="/fleet/"
>
  <PageHero
    priority
    eyebrow="The fleet"
    breadcrumb={[{ label: 'Home', href: '/' }, { label: 'Fleet' }]}
    title="Explore the WMC fleet."
    lead={`${FLEET_TOTAL} WMC-owned vehicles across Cars, Minibuses and Coaches, with transport organised around the requirements of each journey.`}
    primaryCta={{ label: 'Tell Us About Your Journey', href: '/request-a-quote/' }}
    secondaryCta={{ label: 'Explore Fleet', href: '#fleet-categories' }}
    image={heroVisual.image}
    imageAlt={heroVisual.alt}
    cutout
    caption="WMC coach fleet"
    detail={['Cars', 'Minibuses', 'Coaches', 'Driver-operated']}
  />

  <nav class="fleet-nav" id="fleet-categories" aria-label="Fleet categories">
    <PageContainer>
      <ul class="fleet-nav__list">
        {sections.map((section) => (
          <li>
            <a class="fleet-nav__link" href={`#${section.id}`}>
              <span class="fleet-nav__title">{section.title}</span>
              <span class="fleet-nav__count">
                {section.vehicles.length === 1 ? '1 vehicle' : `${section.vehicles.length} vehicles`}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </PageContainer>
  </nav>

  {sections.map((section, sectionIndex) => (
    <Section as="div" surface={sectionIndex % 2 === 0 ? 'warm-white' : 'heritage-ivory'}>
      <PageContainer>
        <div id={section.id} class="category">
          <header class="category__head">
            <p class="eyebrow">{`0${sectionIndex + 1} — ${section.title}`}</p>
            <h2 class="category__title">{section.title}</h2>
            <p class="text-body-large category__copy">{section.copy}</p>
          </header>

          <div class="vehicles">
            {section.vehicles.map((vehicle) => (
              <article class="vehicle">
                <div class:list={['vehicle__media', !vehicle.image && 'vehicle__media--placeholder']}>
                  {vehicle.image ? (
                    <Image
                      src={vehicle.image}
                      alt={`${vehicleLabel(vehicle)}, ${vehicle.seatGroup}`}
                      widths={[420, 700, 1000]}
                      sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                      loading="lazy"
                      class="vehicle__image"
                    />
                  ) : (
                    <p class="vehicle__placeholder">
                      <span class="vehicle__placeholder-mark" aria-hidden="true">WMC</span>
                      Vehicle image being updated
                    </p>
                  )}
                </div>

                <div class="vehicle__body">
                  <div class="vehicle__meta">
                    <p class="vehicle__seats">{vehicle.seatGroup}</p>
                    <p class="vehicle__level">{vehicle.serviceLevel}</p>
                  </div>

                  <h3 class="text-h5 vehicle__name">{vehicle.makeModel}</h3>
                  <p class="vehicle__colour">{vehicle.colour}</p>

                  {vehicle.features.length > 0 && (
                    <ul class="vehicle__features">
                      {vehicle.features.map((feature) => (
                        <li class="vehicle__feature">{feature}</li>
                      ))}
                    </ul>
                  )}

                  <a class="arrow-link vehicle__quote" href={quoteHref(vehicle)}>
                    Request a Quote
                  </a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </PageContainer>
    </Section>
  ))}

  <!-- Client-provided compliance statement. Nothing beyond what WMC confirmed. -->
  <Section as="div" surface="warm-white">
    <PageContainer>
      <div class="standards">
        <p class="eyebrow">Professional standards</p>
        <p class="text-body-large standards__copy">
          All WMC fleet vehicles are DVSA approved, and WMC drivers hold the appropriate licences
          for the transport they operate.
        </p>
      </div>
    </PageContainer>
  </Section>

  <Section as="div" surface="obsidian">
    <PageContainer>
      <div class="help">
        <div>
          <p class="eyebrow eyebrow--dark">Choosing transport</p>
          <h2 class="text-h3 help__title">Not sure which vehicle you need?</h2>
        </div>
        <div class="help__body">
          <p class="text-body-large help__copy">
            Tell WMC about the journey, passenger numbers and luggage requirements and the team can
            review which vehicle category is appropriate.
          </p>
          <Button href="/request-a-quote/" variant="primary" tone="dark">
            Tell Us About Your Journey
          </Button>
        </div>
      </div>
    </PageContainer>
  </Section>
</BaseLayout>

<style>
  /* --------------------------- Category nav --------------------------- */
  .fleet-nav {
    position: sticky;
    inset-block-start: var(--header-offset);
    z-index: 50;
    background-color: var(--color-warm-white);
    border-block-end: var(--border-width-hairline) solid var(--color-linen-border);
  }

  .fleet-nav__list {
    display: flex;
    gap: var(--space-1);
    list-style: none;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    margin-inline: calc(var(--space-3) * -1);
    padding-inline: var(--space-3);
  }

  @media (min-width: 768px) {
    .fleet-nav__list {
      margin-inline: 0;
      padding-inline: 0;
      gap: var(--space-2);
    }
  }

  .fleet-nav__link {
    display: flex;
    flex-direction: column;
    white-space: nowrap;
    gap: 2px;
    flex: 0 0 auto;
    scroll-snap-align: start;
    min-block-size: var(--touch-target-min);
    padding: var(--space-2) var(--space-3);
    text-decoration: none;
    color: var(--color-slate-taupe);
    border-block-end: 2px solid transparent;
    transition: color var(--motion-hover) var(--motion-easing-premium),
      border-color var(--motion-hover) var(--motion-easing-premium);
  }

  .fleet-nav__link:hover,
  .fleet-nav__link:focus-visible {
    color: var(--color-obsidian);
    border-block-end-color: var(--color-champagne-gold);
  }

  .fleet-nav__title {
    font-size: var(--text-h6);
    line-height: var(--leading-h6);
    font-weight: var(--font-weight-semibold);
    color: var(--color-obsidian);
  }

  .fleet-nav__count {
    font-size: var(--text-small);
    line-height: var(--leading-small);
  }

  /* ---------------------------- Category ----------------------------- */
  .category {
    scroll-margin-block-start: calc(var(--header-offset) + 92px);
  }

  .category__head {
    max-inline-size: 62ch;
    margin-block-end: var(--space-6);
  }

  .category__title {
    margin: 0 0 var(--space-2);
  }

  .category__copy {
    color: var(--color-slate-taupe);
    margin: 0;
  }

  /* ---------------------------- Vehicles ----------------------------- */
  .vehicles {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .vehicles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .vehicles {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .vehicle {
    display: flex;
    flex-direction: column;
    border: var(--border-width-hairline) solid var(--color-linen-border);
    border-radius: var(--radius-media);
    background-color: var(--color-warm-white);
    overflow: hidden;
    transition: transform var(--motion-hover) var(--motion-easing-premium),
      border-color var(--motion-hover) var(--motion-easing-premium),
      box-shadow var(--motion-hover) var(--motion-easing-premium);
  }

  @media (hover: hover) and (pointer: fine) {
    .vehicle:hover {
      transform: translateY(-3px);
      border-color: var(--color-mist-taupe);
      box-shadow: var(--shadow-raised);
    }

    .vehicle:hover .vehicle__media :global(.vehicle__image) {
      transform: scale(1.03);
    }
  }

  .vehicle__media {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background-color: var(--color-night-graphite);
  }

  .vehicle__media :global(.vehicle__image) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: contain;
    transition: transform var(--motion-reveal-medium) var(--motion-easing-premium);
  }

  /* Branded stand-in — never another vehicle's photograph. Reads as a
     deliberate WMC panel rather than an empty black rectangle. */
  .vehicle__media--placeholder {
    background-color: var(--color-graphite-surface);
    background-image: linear-gradient(
      135deg,
      rgb(251 249 244 / 0.045) 0%,
      rgb(251 249 244 / 0) 42%,
      rgb(0 0 0 / 0.22) 100%
    );
    padding: var(--space-3);
  }

  .vehicle__placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    margin: 0;
    inline-size: 100%;
    block-size: 100%;
    padding: var(--space-3);
    border: var(--border-width-hairline) solid var(--gold-rule);
    border-radius: var(--radius-panel);
    text-align: center;
    color: var(--color-heritage-ivory);
    font-size: var(--text-small);
    line-height: var(--leading-small);
    letter-spacing: 0.01em;
  }

  .vehicle__placeholder-mark {
    font-size: var(--text-h4);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.16em;
    color: var(--color-champagne-gold);
  }

  .vehicle__placeholder-mark::after {
    content: '';
    display: block;
    inline-size: 40px;
    block-size: 1px;
    margin: var(--space-2) auto 0;
    background-color: var(--gold-rule-strong);
  }

  .vehicle__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-3);
    flex: 1;
  }

  .vehicle__meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .vehicle__seats,
  .vehicle__level {
    margin: 0;
    font-size: var(--text-small);
    line-height: var(--leading-small);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .vehicle__seats {
    color: var(--color-slate-taupe);
  }

  .vehicle__level {
    color: var(--color-champagne-gold);
  }

  .vehicle__name {
    margin: 0;
  }

  .vehicle__colour {
    margin: 0 0 var(--space-2);
    color: var(--color-slate-taupe);
    font-size: var(--text-small);
    line-height: var(--leading-small);
  }

  .vehicle__features {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    list-style: none;
    margin: 0 0 var(--space-3);
    padding: 0;
  }

  .vehicle__feature {
    font-size: var(--text-small);
    line-height: var(--leading-small);
    color: var(--color-slate-taupe);
    padding: 2px var(--space-2);
    border: var(--border-width-hairline) solid var(--color-linen-border);
    border-radius: var(--radius-control);
  }

  .vehicle__quote {
    display: inline-flex;
    align-items: center;
    margin-block-start: auto;
    min-block-size: var(--touch-target-min);
  }

  /* ------------------------------ Help ------------------------------- */
  .standards {
    max-inline-size: 62ch;
  }

  .standards__copy {
    margin: 0;
    color: var(--color-ink);
  }

  .help {
    display: grid;
    gap: var(--space-4);
  }

  .help__title {
    color: var(--color-warm-white);
    margin: 0;
    max-inline-size: 18ch;
  }

  @media (max-width: 479px) {
    .help__body :global(.wmc-button) {
      inline-size: 100%;
    }
  }

  .help__copy {
    color: var(--color-mist-taupe);
    margin: 0 0 var(--space-4);
    max-inline-size: 54ch;
  }

  @media (min-width: 1024px) {
    .help {
      grid-template-columns: 5fr 7fr;
      gap: var(--space-7);
      align-items: start;
    }
  }
</style>
