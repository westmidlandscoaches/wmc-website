---
import Button from '../ui/Button.astro';
import {
  serviceLevels,
  vehicleCategories,
  journeyPurposes,
  referralSources,
  luggageOptions,
  contactMethods,
  steps,
} from '../../data/quoteForm';
import { contact } from '../../data/navigation';
import { fleetBySeatGroup, vehicleLabel } from '../../data/fleet';

const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? '';
/* Optional. Without it every address field stays an ordinary text input. */
const mapsKey = import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY ?? '';

const fleetGroups = fleetBySeatGroup();

const vehicleCopy: Record<string, string> = {
  recommend: 'WMC reviews the journey and recommends a category.',
  car: 'Chauffeur-driven transport.',
  minibus: 'Group transport.',
  coach: 'Larger-group transport.',
};
---

<div
  class="quote-form"
  data-quote-form
  data-whatsapp-href={contact.whatsappHref}
  data-maps-key={mapsKey}
>
  <header class="quote-form__head">
    <p class="eyebrow">Your journey details</p>
    <h2 class="text-h3 quote-form__title">Request a quotation</h2>
    <p class="text-body quote-form__intro">
      Complete the details below and WMC will review your journey requirements.
    </p>

    <!-- Progress. Hidden from JS-less users, who get one linear form instead. -->
    <ol class="progress" data-progress>
      {steps.map((step) => (
        <li class="progress__item" data-step-indicator={step.id}>
          <span class="progress__bar" aria-hidden="true"></span>
          <span class="progress__index">{`0${step.id}`}</span>
          <span class="progress__label">{step.label}</span>
        </li>
      ))}
    </ol>
    <p class="progress__status" data-step-status role="status" hidden></p>
  </header>

  <form class="quote-form__form" data-form novalidate data-access-key={accessKey}>
    <!-- Web3Forms honeypot. Real people never see or fill this. -->
    <label class="visually-hidden" aria-hidden="true">
      Leave this field empty
      <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" />
    </label>

    <!-- STEP 1 -->
    <section class="quote-form__step" data-step="1">
      <div class="error-summary" data-error-summary tabindex="-1" hidden>
        <h3 class="error-summary__title">Check these details</h3>
        <ul data-error-list></ul>
      </div>

      <fieldset class="quote-form__fieldset">
        <legend class="quote-form__legend">
          <span class="quote-form__step-label">Step 1</span>
          <span class="quote-form__step-title text-h4">Journey</span>
          <span class="quote-form__step-intro">Where the journey starts, where it goes and when.</span>
        </legend>

        <div class="field-row">
          <div class="field">
            <label class="field__label" for="pickup">Pickup <span aria-hidden="true">*</span></label>
            <input class="field__input" id="pickup" name="pickup" type="text" required
              placeholder="Address, postcode, airport or venue" autocomplete="off" data-address />
            <p class="field__error" data-error-for="pickup" hidden></p>
          </div>
          <div class="field">
            <label class="field__label" for="destination">Destination <span aria-hidden="true">*</span></label>
            <input class="field__input" id="destination" name="destination" type="text" required
              placeholder="Address, postcode, airport or venue" autocomplete="off" data-address />
            <p class="field__error" data-error-for="destination" hidden></p>
          </div>
        </div>

        <div class="quote-form__stops" data-stops>
          <ol class="quote-form__stop-list" data-stop-list></ol>
          <button type="button" class="link-action" data-add-stop>
            <span aria-hidden="true">+</span> Add a Stop
          </button>
        </div>

        <div class="field-row">
          <div class="field">
            <label class="field__label" for="pickup_date">Pickup Date <span aria-hidden="true">*</span></label>
            <input class="field__input" id="pickup_date" name="pickup_date" type="date" required />
            <p class="field__error" data-error-for="pickup_date" hidden></p>
          </div>
          <div class="field">
            <label class="field__label" for="pickup_time">Pickup Time <span aria-hidden="true">*</span></label>
            <input class="field__input" id="pickup_time" name="pickup_time" type="time" required />
            <p class="field__error" data-error-for="pickup_time" hidden></p>
          </div>
        </div>

        <fieldset class="choice-group">
          <legend class="field__label">Return Journey? <span aria-hidden="true">*</span></legend>
          <div class="choice-grid choice-grid--compact">
            <label class="choice">
              <input type="radio" name="return_journey" value="yes" required />
              <span class="choice__label">Yes</span>
            </label>
            <label class="choice">
              <input type="radio" name="return_journey" value="no" required checked />
              <span class="choice__label">No</span>
            </label>
          </div>
          <p class="field__error" data-error-for="return_journey" hidden></p>
        </fieldset>

        <div class="conditional" data-conditional="return">
          <div class="field-row">
            <div class="field">
              <label class="field__label" for="return_date">Return Date <span aria-hidden="true">*</span></label>
              <input class="field__input" id="return_date" name="return_date" type="date" />
              <p class="field__error" data-error-for="return_date" hidden></p>
            </div>
            <div class="field">
              <label class="field__label" for="return_time">Return Time <span aria-hidden="true">*</span></label>
              <input class="field__input" id="return_time" name="return_time" type="time" />
              <p class="field__error" data-error-for="return_time" hidden></p>
            </div>
          </div>
        </div>
      </fieldset>

      <div class="action-bar" data-actions>
        <div class="action-bar__note"></div>
        <div class="action-bar__buttons">
          <Button type="button" variant="primary" data-next>Continue</Button>
        </div>
      </div>
    </section>

    <!-- STEP 2 -->
    <section class="quote-form__step" data-step="2">
      <div class="error-summary" data-error-summary tabindex="-1" hidden>
        <h3 class="error-summary__title">Check these details</h3>
        <ul data-error-list></ul>
      </div>

      <fieldset class="quote-form__fieldset">
        <legend class="quote-form__legend">
          <span class="quote-form__step-label">Step 2</span>
          <span class="quote-form__step-title text-h4">Passengers &amp; contact</span>
          <span class="quote-form__step-intro">Who is travelling, and how WMC should reach you.</span>
        </legend>

        <div class="field-row">
          <div class="field">
            <label class="field__label" for="full_name">Full Name <span aria-hidden="true">*</span></label>
            <input class="field__input" id="full_name" name="full_name" type="text" required autocomplete="name" />
            <p class="field__error" data-error-for="full_name" hidden></p>
          </div>
          <div class="field">
            <label class="field__label" for="organisation">Organisation / Company</label>
            <input class="field__input" id="organisation" name="organisation" type="text" autocomplete="organization" />
          </div>
        </div>

        <div class="field-row">
          <div class="field">
            <label class="field__label" for="email">Email <span aria-hidden="true">*</span></label>
            <input class="field__input" id="email" name="email" type="email" required autocomplete="email" inputmode="email" />
            <p class="field__error" data-error-for="email" hidden></p>
          </div>
          <div class="field">
            <label class="field__label" for="contact_number">Contact Number <span aria-hidden="true">*</span></label>
            <input class="field__input" id="contact_number" name="contact_number" type="tel" required autocomplete="tel" inputmode="tel" />
            <p class="field__error" data-error-for="contact_number" hidden></p>
          </div>
        </div>

        <div class="field-row">
          <div class="field">
            <label class="field__label" for="passengers">Number of Passengers <span aria-hidden="true">*</span></label>
            <input class="field__input" id="passengers" name="passengers" type="number" min="1" step="1" required inputmode="numeric" />
            <p class="field__error" data-error-for="passengers" hidden></p>
          </div>
          <div class="field">
            <fieldset class="choice-group choice-group--inline">
              <legend class="field__label">Luggage <span aria-hidden="true">*</span></legend>
              <div class="choice-grid choice-grid--compact">
                {luggageOptions.map((option) => (
                  <label class="choice">
                    <input type="radio" name="luggage" value={option.value} required />
                    <span class="choice__label">{option.label}</span>
                  </label>
                ))}
              </div>
              <p class="field__error" data-error-for="luggage" hidden></p>
            </fieldset>
          </div>
        </div>

        <div class="conditional" data-conditional="luggage">
          <div class="field-row">
            <div class="field">
              <label class="field__label" for="luggage_cases">Approximate number of large cases</label>
              <input class="field__input" id="luggage_cases" name="luggage_cases" type="number" min="0" step="1" inputmode="numeric" />
            </div>
            <div class="field">
              <label class="field__label" for="luggage_other">Other / bulky luggage</label>
              <input class="field__input" id="luggage_other" name="luggage_other" type="text" />
            </div>
          </div>
        </div>
      </fieldset>

      <div class="action-bar" data-actions>
        <div class="action-bar__note"></div>
        <div class="action-bar__buttons">
          <Button type="button" variant="secondary" data-back>Back</Button>
          <Button type="button" variant="primary" data-next>Continue</Button>
        </div>
      </div>
    </section>

    <!-- STEP 3 -->
    <section class="quote-form__step" data-step="3">
      <div class="error-summary" data-error-summary tabindex="-1" hidden>
        <h3 class="error-summary__title">Check these details</h3>
        <ul data-error-list></ul>
      </div>

      <fieldset class="quote-form__fieldset">
        <legend class="quote-form__legend">
          <span class="quote-form__step-label">Step 3</span>
          <span class="quote-form__step-title text-h4">Vehicle &amp; requirements</span>
          <span class="quote-form__step-intro">
            Choose your preferred service level and tell WMC what type of transport you have in mind.
          </span>
        </legend>

        <!-- A. SERVICE LEVEL -->
        <fieldset class="choice-group section-block">
          <legend class="section-block__title">Service level <span aria-hidden="true">*</span></legend>
          <div class="choice-grid choice-grid--three">
            {serviceLevels.map((option) => (
              <label class="option-card">
                <input type="radio" name="service_level" value={option.value} required />
                <span class="option-card__body">
                  <span class="option-card__name">{option.label}</span>
                  <span class="option-card__copy">{option.description}</span>
                </span>
              </label>
            ))}
          </div>
          <p class="field__error" data-error-for="service_level" hidden></p>
        </fieldset>

        <!-- B. VEHICLE PREFERENCE -->
        <fieldset class="choice-group section-block">
          <legend class="section-block__title">Vehicle preference <span aria-hidden="true">*</span></legend>
          <div class="choice-grid choice-grid--four">
            {vehicleCategories.map((option) => (
              <label class="option-card option-card--compact">
                <input type="radio" name="vehicle_category" value={option.value} required
                  checked={option.value === 'recommend'} />
                <span class="option-card__body">
                  <span class="option-card__name">{option.label}</span>
                  <span class="option-card__copy">{vehicleCopy[option.value]}</span>
                </span>
              </label>
            ))}
          </div>
          <p class="field__error" data-error-for="vehicle_category" hidden></p>
        </fieldset>

        <!-- C. JOURNEY CONTEXT -->
        <div class="section-block">
          <p class="section-block__title">Journey context</p>
          <div class="field-row">
            <div class="field">
              <label class="field__label" for="journey_purpose">Journey purpose</label>
              <div class="select-wrap wmc-select">
                <select class="field__input" id="journey_purpose" name="journey_purpose">
                  <option value="">Select a purpose</option>
                  {journeyPurposes.map((option) => (
                    <option value={option.value}>{option.label}</option>
                  ))}
                </select>
              </div>
            </div>
            <div class="field">
              <label class="field__label" for="preferred_vehicle">
                Preferred WMC Vehicle <span class="field__optional">Optional</span>
              </label>
              <div class="select-wrap wmc-select">
                <select class="field__input" id="preferred_vehicle" name="preferred_vehicle">
                  <option value="">No specific vehicle preference</option>
                  {fleetGroups.map((group) => (
                    <optgroup label={group.seatGroup} data-seat-group={group.seatGroup}>
                      {group.vehicles.map((vehicle) => (
                        <option
                          value={vehicle.id}
                          data-service-level={vehicle.serviceLevel.toLowerCase()}
                          data-category={vehicle.category}
                          data-seats={vehicle.seatGroup}
                        >
                          {vehicleLabel(vehicle)}
                        </option>
                      ))}
                    </optgroup>
                  ))}
                  <option class="vehicle-empty" value="" data-empty-state hidden>
                    No matching WMC vehicle — change your preferences or choose “Please recommend”.
                  </option>
                </select>
              </div>
              <p class="field__help">
                A specific vehicle can be requested as a preference; availability is confirmed separately.
              </p>
            </div>
          </div>
        </div>

        <!-- D. ADDITIONAL DETAILS -->
        <div class="section-block">
          <p class="section-block__title">Additional details</p>
          <div class="field">
            <label class="field__label" for="additional_info">Additional information</label>
            <textarea class="field__input field__textarea" id="additional_info" name="additional_info" rows="5"
              placeholder="Tell us about any additional journey, accessibility or transport requirements."></textarea>
          </div>
          <div class="field field--half">
            <label class="field__label" for="referral_source">
              Where did you find us? <span class="field__optional">Optional</span>
            </label>
            <div class="select-wrap wmc-select">
              <select class="field__input" id="referral_source" name="referral_source">
                <option value="">Prefer not to say</option>
                {referralSources.map((option) => (
                  <option value={option.value}>{option.label}</option>
                ))}
              </select>
            </div>
          </div>
        </div>

        <!-- E. CONTACT PREFERENCE -->
        <fieldset class="choice-group section-block">
          <legend class="section-block__title">Preferred contact method <span aria-hidden="true">*</span></legend>
          <div class="choice-grid choice-grid--two">
            {contactMethods.map((option) => (
              <label class="option-card option-card--compact">
                <input type="radio" name="preferred_contact_method" value={option.value} required />
                <span class="option-card__body">
                  <span class="option-card__name">{option.label}</span>
                </span>
              </label>
            ))}
          </div>
          <p class="field__help">WMC will use the email address or number you provided in step 2.</p>
          <p class="field__error" data-error-for="preferred_contact_method" hidden></p>
        </fieldset>
      </fieldset>

      <!-- REVIEW -->
      <section class="review" data-review hidden aria-live="polite">
        <h3 class="review__title text-h5">Review your request</h3>
        <div class="review__grid" data-review-body></div>
      </section>

      <div class="action-bar action-bar--submit" data-actions>
        <p class="action-bar__note">
          Submitting this form sends a quotation request. It does not confirm a booking or guarantee
          vehicle availability.
        </p>
        <div class="action-bar__buttons">
          <Button type="button" variant="secondary" data-back>Back</Button>
          <Button type="submit" variant="primary">Send Quote Request</Button>
        </div>
      </div>
    </section>
  </form>

  <!-- Result panels. Shown only after Web3Forms confirms an outcome. -->
  <section class="result result--success" data-result-success role="status" tabindex="-1" hidden>
    <p class="eyebrow">Quotation request</p>
    <h3 class="text-h4 result__title">Quote request received.</h3>
    <p class="text-body result__copy">
      Thank you. WMC has received your journey details and will review the request before responding
      through your preferred contact method.
    </p>
  </section>

  <section class="result result--error" data-result-error role="alert" tabindex="-1" hidden>
    <h3 class="text-h4 result__title">We couldn't send your quote request.</h3>
    <p class="text-body result__copy">
      Your details have been kept. Please try again, or contact WMC by phone or WhatsApp.
    </p>
    <div class="result__actions">
      <Button type="button" variant="primary" data-retry>Try Again</Button>
      <Button href={contact.phoneHref} variant="secondary">Call {contact.phoneDisplay}</Button>
      <Button href={contact.whatsappHref} variant="secondary">WhatsApp</Button>
    </div>
  </section>
</div>

<template data-stop-template>
  <li class="quote-form__stop">
    <div class="field">
      <label class="field__label">Stop</label>
      <input class="field__input" type="text" placeholder="Address, postcode, airport or venue"
        autocomplete="off" data-address />
    </div>
    <button type="button" class="quote-form__remove-stop" data-remove-stop>
      <span class="visually-hidden">Remove stop</span>
      <span aria-hidden="true">&times;</span>
    </button>
  </li>
</template>

<style>
  /* ---------------------------------------------------------------
     Shell
     --------------------------------------------------------------- */
  .quote-form {
    max-inline-size: 1120px;
    margin-inline: auto;
    border: var(--border-width-hairline) solid var(--color-linen-border);
    border-radius: var(--radius-media);
    background-color: var(--color-warm-white);
    box-shadow: var(--shadow-low);
    /* Deliberately not overflow: hidden — that clipped the address
       autocomplete dropdown. The only child needing the rounded corner is the
       head, which now clips its own. */
  }

  .quote-form__head {
    border-start-start-radius: var(--radius-media);
    border-start-end-radius: var(--radius-media);
  }

  .quote-form__head {
    padding: var(--space-4) var(--space-3);
    border-block-end: var(--border-width-hairline) solid var(--color-linen-border);
    background-color: var(--color-heritage-ivory);
  }

  .quote-form__form {
    padding: var(--space-4) var(--space-3) var(--space-5);
  }

  @media (min-width: 768px) {
    .quote-form__head {
      padding: var(--space-5) var(--space-4);
    }

    .quote-form__form {
      padding: var(--space-4) var(--space-4) var(--space-5);
    }
  }

  @media (min-width: 1024px) {
    .quote-form__head {
      padding: var(--space-6) var(--space-6) var(--space-5);
    }

    .quote-form__form {
      padding: var(--space-6);
    }
  }

  .quote-form__title {
    margin: 0 0 var(--space-1);
  }

  .quote-form__intro {
    color: var(--color-slate-taupe);
    margin: 0;
    max-inline-size: 64ch;
  }

  /* ---------------------------------------------------------------
     Progress
     --------------------------------------------------------------- */
  .progress {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-2);
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
  }

  .progress__item {
    display: grid;
    gap: 2px;
    color: var(--color-slate-taupe);
  }

  .progress__bar {
    display: block;
    block-size: 3px;
    border-radius: 2px;
    background-color: var(--color-linen-border);
    margin-block-end: var(--space-2);
    transition: background-color var(--motion-hover) var(--motion-easing-premium);
  }

  .progress__item[data-state='current'] .progress__bar,
  .progress__item[data-state='done'] .progress__bar {
    background-color: var(--color-champagne-gold);
  }

  .progress__index {
    font-size: var(--text-small);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.12em;
  }

  .progress__item[data-state='current'] .progress__index,
  .progress__item[data-state='current'] .progress__label {
    color: var(--color-obsidian);
  }

  /* Completed steps carry a tick as well as colour. */
  .progress__item[data-state='done'] .progress__index::after {
    content: ' \2713';
    color: var(--color-success-light);
  }

  .progress__label {
    font-size: var(--text-small);
    line-height: var(--leading-small);
    font-weight: var(--font-weight-semibold);
  }

  @media (max-width: 767px) {
    .progress__index,
    .progress__label {
      display: none;
    }

    .progress {
      gap: var(--space-1);
    }
  }

  .progress__status {
    font-size: var(--text-small);
    line-height: var(--leading-small);
    font-weight: var(--font-weight-semibold);
    color: var(--color-obsidian);
    margin: var(--space-2) 0 0;
  }

  /* ---------------------------------------------------------------
     Step scaffolding
     --------------------------------------------------------------- */
  .quote-form__fieldset {
    border: 0;
    margin: 0;
    padding: 0;
  }

  /* The step animates in with a transform; a lingering transform would make
     this element the containing block for the address dropdown, so it is
     cleared once the animation finishes. */
  .quote-form__step {
    animation-fill-mode: none;
  }

  .quote-form__step,
  .action-bar,
  .error-summary {
    /* Never come to rest underneath the sticky header, which would leave the
       top of a control visually covered and unclickable. */
    scroll-margin-block-start: calc(var(--header-offset) + var(--space-3));
  }

  .quote-form__legend {
    display: grid;
    gap: 2px;
    padding: 0;
    margin-block-end: var(--space-4);
  }

  .quote-form__step-label {
    font-size: var(--text-small);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-champagne-gold);
  }

  .quote-form__step-title {
    color: var(--color-obsidian);
  }

  .quote-form__step-intro {
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--color-slate-taupe);
    max-inline-size: 62ch;
  }

  /* Without JS every step is simply a section of one long form. */
  .quote-form__step + .quote-form__step {
    margin-block-start: var(--space-6);
    padding-block-start: var(--space-5);
    border-block-start: var(--border-width-hairline) solid var(--color-linen-border);
  }

  .section-block {
    border: 0;
    margin: 0 0 var(--space-5);
    padding: 0 0 var(--space-5);
    border-block-end: var(--border-width-hairline) solid var(--color-linen-border);
  }

  .section-block:last-of-type {
    border-block-end: 0;
    padding-block-end: 0;
    margin-block-end: var(--space-3);
  }

  .section-block__title {
    display: block;
    padding: 0;
    font-size: var(--text-small);
    line-height: var(--leading-small);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-slate-taupe);
    margin: 0 0 var(--space-3);
  }

  .section-block__title span {
    color: var(--color-champagne-gold);
  }

  /* ---------------------------------------------------------------
     Fields
     --------------------------------------------------------------- */
  .field {
    margin-block-end: var(--space-4);
  }

  .field--half {
    max-inline-size: 420px;
  }

  .field__label {
    display: block;
    font-size: var(--text-form-label);
    line-height: var(--leading-form-label);
    font-weight: var(--font-weight-semibold);
    color: var(--color-ink);
    margin-block-end: var(--space-1);
    padding: 0;
  }

  .field__label > span[aria-hidden] {
    color: var(--color-champagne-gold);
  }

  .field__optional {
    font-weight: var(--font-weight-regular);
    color: var(--color-slate-taupe);
    letter-spacing: 0.04em;
    font-size: var(--text-small);
  }

