<script>
  /**
   * Google Places (New) address autocomplete.
   *
   * Strictly an enhancement over the existing inputs: it never replaces a
   * control, never blocks typing, and stands down silently when the key is
   * absent or any Google call fails. Nothing about a prediction — the query,
   * the place or its coordinates — is logged or stored anywhere beyond the
   * form field the customer can already see.
   */
  interface PlacePrediction {
    text: { toString(): string };
    mainText?: { toString(): string } | null;
    secondaryText?: { toString(): string } | null;
    toPlace(): {
      fetchFields(options: { fields: string[] }): Promise<unknown>;
      formattedAddress?: string | null;
      displayName?: string | null;
    };
  }

  interface PlacesLib {
    AutocompleteSuggestion: {
      fetchAutocompleteSuggestions(request: Record<string, unknown>): Promise<{
        suggestions: { placePrediction: PlacePrediction | null }[];
      }>;
    };
    AutocompleteSessionToken: new () => unknown;
  }

  const host = document.querySelector<HTMLElement>('[data-quote-form]');
  const mapsKey = host?.dataset.mapsKey?.trim() ?? '';

  if (host && mapsKey) {
    let placesPromise: Promise<PlacesLib | null> | null = null;

    /** Loads the Maps JS API once, on the first keystroke in an address field. */
    const loadPlaces = (): Promise<PlacesLib | null> => {
      if (placesPromise) return placesPromise;

      placesPromise = new Promise<PlacesLib | null>((resolve) => {
        const w = window as unknown as {
          google?: { maps?: { importLibrary?: (name: string) => Promise<unknown> } };
        };

        const importLib = () => {
          const fn = w.google?.maps?.importLibrary;
          if (!fn) return resolve(null);
          fn('places')
            .then((lib) => {
              const ok = Boolean(
                (lib as PlacesLib)?.AutocompleteSuggestion &&
                  (lib as PlacesLib)?.AutocompleteSessionToken,
              );
              resolve(ok ? (lib as PlacesLib) : null);
            })
            .catch(() => resolve(null));
        };

        if (w.google?.maps?.importLibrary) return importLib();

        // With loading=async the script's own load event fires before the
        // bootstrap has installed google.maps.importLibrary, so Google requires
        // the callback parameter to signal readiness. Waiting on load alone is
        // why this silently found no library.
        const callbackName = '__wmcMapsReady';
        const globals = w as unknown as Record<string, unknown>;

        let settled = false;
        const finish = (lib: PlacesLib | null) => {
          if (settled) return;
          settled = true;
          delete globals[callbackName];
          resolve(lib);
        };

        globals[callbackName] = () => {
          const fn = w.google?.maps?.importLibrary;
          if (!fn) return finish(null);
          fn('places')
            .then((lib) => {
              const ok = Boolean(
                (lib as PlacesLib)?.AutocompleteSuggestion &&
                  (lib as PlacesLib)?.AutocompleteSessionToken,
              );
              finish(ok ? (lib as PlacesLib) : null);
            })
            .catch(() => finish(null));
        };

        const script = document.createElement('script');
        script.async = true;
        script.src =
          'https://maps.googleapis.com/maps/api/js' +
          '?libraries=places&loading=async&v=weekly' +
          '&callback=' + callbackName +
          '&key=' + encodeURIComponent(mapsKey);
        script.addEventListener('error', () => finish(null));
        // A blocked or hung loader must not leave typing waiting forever.
        window.setTimeout(() => finish(null), 10000);
        document.head.appendChild(script);
      });

      return placesPromise;
    };

    let uid = 0;

    const enhance = (input: HTMLInputElement) => {
      if (input.dataset.addressReady === 'true') return;
      input.dataset.addressReady = 'true';

      const wrapper = input.closest<HTMLElement>('.field');
      if (!wrapper) return;
      wrapper.classList.add('address-field');

      const listId = `address-listbox-${(uid += 1)}`;
      const list = document.createElement('ul');
      list.className = 'address-listbox';
      list.id = listId;
      list.setAttribute('role', 'listbox');
      list.hidden = true;
      wrapper.appendChild(list);

      input.setAttribute('role', 'combobox');
      input.setAttribute('aria-autocomplete', 'list');
      input.setAttribute('aria-expanded', 'false');
      input.setAttribute('aria-controls', listId);

      interface Row {
        full: string;
        main: string;
        secondary: string;
        prediction: PlacePrediction;
      }

      let rows: Row[] = [];
      let activeIndex = -1;
      let sessionToken: unknown = null;
      let debounce = 0;
      let sequence = 0;
      // Set while writing a chosen address, so the input event that carries
      // the value into form state cannot be mistaken for fresh typing and
      // reopen the list.
      let committing = false;

      const close = () => {
        // Retire any in-flight query so a late response cannot reopen the list
        // after it has been dismissed or a prediction has been chosen.
        sequence += 1;
        window.clearTimeout(debounce);
        list.hidden = true;
        list.replaceChildren();
        input.setAttribute('aria-expanded', 'false');
        input.removeAttribute('aria-activedescendant');
        rows = [];
        activeIndex = -1;
      };

      const setActive = (index: number) => {
        activeIndex = index;
        Array.from(list.children).forEach((node, i) => {
          const li = node as HTMLElement;
          const on = i === index;
          li.dataset.active = String(on);
          li.setAttribute('aria-selected', String(on));
          if (on) {
            input.setAttribute('aria-activedescendant', li.id);
            li.scrollIntoView({ block: 'nearest' });
          }
        });
        if (index < 0) input.removeAttribute('aria-activedescendant');
      };

      /** Writes into the existing form state exactly as typing would. */
      const commit = (val: string) => {
        committing = true;
        input.value = val;
        input.dispatchEvent(new Event('input', { bubbles: true }));
        input.dispatchEvent(new Event('change', { bubbles: true }));
        committing = false;
      };

      const choose = async (index: number) => {
        const chosen = rows[index];
        if (!chosen) return;

        // Show the prediction straight away, then refine it to the formatted
        // address once Google answers, so a slow lookup never blocks anyone.
        commit(chosen.full);
        close();

        try {
          const place = chosen.prediction.toPlace();
          await place.fetchFields({ fields: ['formattedAddress', 'displayName'] });
          const name = (place.displayName ?? '').trim();
          const address = (place.formattedAddress ?? '').trim();
          if (!address) return;
          // Keep a venue or airport name that the postal address omits.
          commit(name && !address.startsWith(name) ? `${name}, ${address}` : address);
        } catch {
          /* The prediction text already in the field remains valid. */
        }
        // A session ends with a selection; the next query starts a new one.
        sessionToken = null;
      };

      const render = () => {
        list.replaceChildren();
        rows.forEach((row, i) => {
          const li = document.createElement('li');
          li.id = `${listId}-option-${i}`;
          li.className = 'address-option';
          li.setAttribute('role', 'option');
          li.setAttribute('aria-selected', 'false');
          li.dataset.active = 'false';

          const main = document.createElement('span');
          main.className = 'address-option__main';
          main.textContent = row.main;
          li.appendChild(main);

          if (row.secondary) {
            const secondary = document.createElement('span');
            secondary.className = 'address-option__secondary';
            secondary.textContent = row.secondary;
            li.appendChild(secondary);
          }

          // pointerdown lands before the input blurs, so taps always register.
          li.addEventListener('pointerdown', (event) => {
            event.preventDefault();
            void choose(i);
          });

          list.appendChild(li);
        });

        list.hidden = rows.length === 0;
        input.setAttribute('aria-expanded', String(rows.length > 0));
        setActive(-1);
      };

      const query = async (text: string) => {
        const places = await loadPlaces();
        if (!places) return close();

        const mine = (sequence += 1);
        try {
          if (!sessionToken) sessionToken = new places.AutocompleteSessionToken();
          const { suggestions } = await places.AutocompleteSuggestion.fetchAutocompleteSuggestions({
            input: text,
            includedRegionCodes: ['gb'],
            sessionToken,
          });
          if (mine !== sequence) return; // a newer keystroke already won

          rows = suggestions
            .map((s) => s.placePrediction)
            .filter((prediction): prediction is PlacePrediction => Boolean(prediction))
            .slice(0, 6)
            .map((prediction) => ({
              full: prediction.text.toString(),
              main: prediction.mainText?.toString() ?? prediction.text.toString(),
              secondary: prediction.secondaryText?.toString() ?? '',
              prediction,
            }));
          render();
        } catch {
          // Quota, network or key problems all degrade to manual typing.
          close();
        }
      };

      input.addEventListener('input', () => {
        if (committing) return;
        window.clearTimeout(debounce);
        const text = input.value.trim();
        if (text.length < 3) return close();
        debounce = window.setTimeout(() => void query(text), 220);
      });

      input.addEventListener('keydown', (event) => {
        if (list.hidden || rows.length === 0) return;

        if (event.key === 'ArrowDown') {
          event.preventDefault();
          setActive((activeIndex + 1) % rows.length);
        } else if (event.key === 'ArrowUp') {
          event.preventDefault();
          setActive(activeIndex <= 0 ? rows.length - 1 : activeIndex - 1);
        } else if (event.key === 'Enter' && activeIndex >= 0) {
          // Only swallow Enter when it is choosing a prediction, so the key
          // still reaches the form otherwise.
          event.preventDefault();
          void choose(activeIndex);
        } else if (event.key === 'Escape') {
          event.preventDefault();
          close();
        } else if (event.key === 'Tab' && activeIndex >= 0) {
          void choose(activeIndex);
        }
      });

      input.addEventListener('blur', () => {
        window.setTimeout(close, 120);
      });
    };

    const scan = () => {
      host.querySelectorAll<HTMLInputElement>('input[data-address]').forEach(enhance);
    };

    scan();

    // Stops are cloned from a template at runtime, so watch for new ones.
    const stopList = host.querySelector<HTMLElement>('[data-stop-list]');
    if (stopList) {
      new MutationObserver(scan).observe(stopList, { childList: true, subtree: true });
    }
  }
</script>


<script is:inline>
  document.documentElement.classList.add('js-quote-form');
</script>

<script>
  const root = document.querySelector<HTMLElement>('[data-quote-form]');
  const form = root?.querySelector<HTMLFormElement>('[data-form]');

  if (root && form) {
    const stepEls = Array.from(root.querySelectorAll<HTMLElement>('[data-step]'));
    const indicators = Array.from(root.querySelectorAll<HTMLElement>('[data-step-indicator]'));
    const status = root.querySelector<HTMLElement>('[data-step-status]');
    const review = root.querySelector<HTMLElement>('[data-review]');
    const reviewBody = root.querySelector<HTMLElement>('[data-review-body]');
    const stopList = root.querySelector<HTMLElement>('[data-stop-list]');
    const stopTemplate = document.querySelector<HTMLTemplateElement>('[data-stop-template]');
    const STORAGE_KEY = 'wmc-quote-draft';

    const stepLabels = ['Journey', 'Passengers & Contact', 'Vehicle & Requirements'];
    let current = 1;

    const field = (name: string) =>
      form.querySelector<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(`[name="${name}"]`);
    const value = (name: string) => {
      const radios = form.querySelectorAll<HTMLInputElement>(`input[type="radio"][name="${name}"]`);
      if (radios.length) {
        const checked = Array.from(radios).find((r) => r.checked);
        return checked ? checked.value : '';
      }
      return field(name)?.value.trim() ?? '';
    };
    /**
     * Several supplied vehicle labels are identical, so the capacity group is
     * appended for the inbox and the review. Both values are client-supplied.
     */
    const preferredVehicleLabel = () => {
      const select = form.querySelector<HTMLSelectElement>('[name="preferred_vehicle"]');
      const option = select?.selectedOptions[0];
      if (!option || !option.value) return '';
      const seats = option.dataset.seats;
      const label = option.textContent?.trim() ?? '';
      return seats ? `${label} (${seats})` : label;
    };

    const labelFor = (name: string) => {
      const radios = form.querySelectorAll<HTMLInputElement>(`input[type="radio"][name="${name}"]`);
      if (radios.length) {
        const checked = Array.from(radios).find((r) => r.checked);
        return (
          checked?.parentElement?.querySelector('.choice__label, .option-card__name')?.textContent?.trim() ?? ''
        );
      }
      const el = field(name);
      if (el instanceof HTMLSelectElement) return el.selectedOptions[0]?.textContent?.trim() ?? '';
      return el?.value.trim() ?? '';
    };

    // --- draft persistence (session only) ---
    const saveDraft = () => {
      try {
        const data: Record<string, string> = {};
        new FormData(form).forEach((v, k) => {
          if (typeof v === 'string') data[k] = v;
        });
        sessionStorage.setItem(STORAGE_KEY, JSON.stringify(data));
      } catch {
        /* storage unavailable — the form still works, it just will not persist */
      }
    };

    // --- step display ---
    const showStep = (step: number, focus = true) => {
      current = Math.min(3, Math.max(1, step));
      stepEls.forEach((el) => {
        el.dataset.active = String(Number(el.dataset.step) === current);
      });
      indicators.forEach((el) => {
        const id = Number(el.dataset.stepIndicator);
        el.dataset.state = id === current ? 'current' : id < current ? 'done' : 'todo';
      });
      if (status) {
        status.hidden = false;
        status.textContent = `Step ${current} of 3 — ${stepLabels[current - 1]}`;
      }
      if (review) review.hidden = current !== 3;
      if (current === 3) renderReview();
      if (focus) {
        const heading = stepEls[current - 1]?.querySelector<HTMLElement>('.quote-form__legend');
        heading?.setAttribute('tabindex', '-1');
        heading?.focus();
      }
    };

    /**
     * The specific-vehicle list only ever offers vehicles that match the
     * chosen service level and category. A selection that stops matching is
     * cleared rather than silently submitted.
     */
    const preferredVehicle = form.querySelector<HTMLSelectElement>('[name="preferred_vehicle"]');
    const emptyOption = preferredVehicle?.querySelector<HTMLOptionElement>('[data-empty-state]');

    const syncVehicleOptions = () => {
      if (!preferredVehicle) return;

      const level = value('service_level');
      const category = value('vehicle_category');
      const options = Array.from(
        preferredVehicle.querySelectorAll<HTMLOptionElement>('option[data-service-level]'),
      );

      let matches = 0;
      for (const option of options) {
        const levelOk = !level || option.dataset.serviceLevel === level;
        const categoryOk =
          !category || category === 'recommend' || option.dataset.category === category;
        const show = levelOk && categoryOk;
        option.hidden = !show;
        option.disabled = !show;
        if (show) matches += 1;
      }

      // Empty optgroups would otherwise leave stray capacity headings behind.
      for (const group of preferredVehicle.querySelectorAll<HTMLOptGroupElement>('optgroup')) {
        const anyVisible = Array.from(group.querySelectorAll('option')).some((o) => !o.hidden);
        group.hidden = !anyVisible;
      }

      if (emptyOption) {
        emptyOption.hidden = matches > 0;
        emptyOption.disabled = true;
      }

      const selected = preferredVehicle.selectedOptions[0];
      if (selected && selected.hidden) preferredVehicle.value = '';
    };

    // --- conditionals ---
    const syncConditionals = () => {
      const ret = root.querySelector<HTMLElement>('[data-conditional="return"]');
      const showReturn = value('return_journey') === 'yes';
      if (ret) ret.dataset.visible = String(showReturn);
      ['return_date', 'return_time'].forEach((n) => {
        const el = field(n);
        if (el instanceof HTMLInputElement) el.required = showReturn;
      });

      const lug = root.querySelector<HTMLElement>('[data-conditional="luggage"]');
      if (lug) lug.dataset.visible = String(value('luggage') === 'yes');

      syncVehicleOptions();
    };

    form.addEventListener('change', (event) => {
      const target = event.target as HTMLElement;
      if (
        target instanceof HTMLInputElement &&
        (target.name === 'return_journey' || target.name === 'luggage')
      ) {
        syncConditionals();
      }

      if (
        target instanceof HTMLInputElement &&
        (target.name === 'service_level' || target.name === 'vehicle_category')
      ) {
        syncVehicleOptions();
      }
      saveDraft();
    });
    form.addEventListener('input', saveDraft);

    // --- stops ---
    const renumberStops = () => {
      if (!stopList) return;
      Array.from(stopList.children).forEach((li, index) => {
        const input = li.querySelector<HTMLInputElement>('input');
        const label = li.querySelector<HTMLLabelElement>('label');
        const id = `stop_${index + 1}`;
        if (input) {
          input.name = `stop_${index + 1}`;
          input.id = id;
        }
        if (label) {
          label.setAttribute('for', id);
          label.textContent = `Stop ${index + 1}`;
        }
      });
    };

    root.querySelector('[data-add-stop]')?.addEventListener('click', () => {
      if (!stopList || !stopTemplate) return;
      const node = stopTemplate.content.cloneNode(true) as DocumentFragment;
      stopList.appendChild(node);
      renumberStops();
      const inputs = stopList.querySelectorAll<HTMLInputElement>('input');
      inputs[inputs.length - 1]?.focus();
      saveDraft();
    });

    stopList?.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest('[data-remove-stop]');
      if (!button) return;
      button.closest('li')?.remove();
      renumberStops();
      saveDraft();
    });

    // --- validation ---
    const setError = (name: string, message: string) => {
      const el = field(name);
      const holder = form.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
      if (holder) {
        holder.textContent = message;
        holder.hidden = false;
        holder.id = holder.id || `error-${name}`;
      }
      if (el) {
        el.setAttribute('aria-invalid', 'true');
        if (holder) el.setAttribute('aria-describedby', holder.id);
      }
    };

    const clearError = (name: string) => {
      const el = field(name);
      const holder = form.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
      if (holder) {
        holder.hidden = true;
        holder.textContent = '';
      }
      el?.removeAttribute('aria-invalid');
      el?.removeAttribute('aria-describedby');
    };

    const isEmail = (v: string) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);
    const hasDigits = (v: string) => (v.match(/\d/g) ?? []).length >= 7;

    const validateStep = (step: number) => {
      const errors: { name: string; message: string }[] = [];
      const require = (name: string, message: string) => {
        if (!value(name)) errors.push({ name, message });
      };

      if (step === 1) {
        require('pickup', 'Enter a pickup location.');
        require('destination', 'Enter a destination.');
        require('pickup_date', 'Enter the pickup date.');
        require('pickup_time', 'Enter the pickup time.');
        require('return_journey', 'Choose whether a return journey is needed.');

        const today = new Date();
        today.setHours(0, 0, 0, 0);
        const pickupDate = value('pickup_date');
        if (pickupDate && new Date(`${pickupDate}T00:00`) < today) {
          errors.push({ name: 'pickup_date', message: 'The pickup date cannot be in the past.' });
        }

        if (value('return_journey') === 'yes') {
          require('return_date', 'Enter the return date.');
          require('return_time', 'Enter the return time.');
          const rd = value('return_date');
          const rt = value('return_time');
          const pt = value('pickup_time');
          if (pickupDate && rd) {
            const out = new Date(`${pickupDate}T${pt || '00:00'}`);
            const back = new Date(`${rd}T${rt || '00:00'}`);
            if (back < out) {
              errors.push({ name: 'return_date', message: 'The return cannot be before the outbound journey.' });
            }
          }
        }
      }

      if (step === 2) {
        require('full_name', 'Enter your full name.');
        require('email', 'Enter your email address.');
        require('contact_number', 'Enter a contact number.');
        require('passengers', 'Enter the number of passengers.');
        require('luggage', 'Choose a luggage option.');

        const email = value('email');
        if (email && !isEmail(email)) {
          errors.push({ name: 'email', message: 'Enter a valid email address.' });
        }
        const passengers = Number(value('passengers'));
        if (value('passengers') && (!Number.isFinite(passengers) || passengers < 1)) {
          errors.push({ name: 'passengers', message: 'Enter at least one passenger.' });
        }
      }

      if (step === 3) {
        require('service_level', 'Choose a service level.');
        require('vehicle_category', 'Choose a vehicle preference.');
        require('preferred_contact_method', 'Choose a preferred contact method.');

        const method = value('preferred_contact_method');
        if (method === 'email' && !isEmail(value('email'))) {
          errors.push({ name: 'preferred_contact_method', message: 'A valid email address is needed for email contact. Check step 2.' });
        }
        if (method === 'whatsapp' && !hasDigits(value('contact_number'))) {
          errors.push({ name: 'preferred_contact_method', message: 'A usable contact number is needed for WhatsApp. Check step 2.' });
        }
      }

      return errors;
    };

    /** Clears every step's errors so a summary can never outlive its step. */
    const clearAllErrors = () => {
      form.querySelectorAll<HTMLElement>('[data-error-for]').forEach((el) => {
        clearError(el.dataset.errorFor as string);
      });
      form.querySelectorAll<HTMLElement>('[data-error-summary]').forEach((el) => {
        el.hidden = true;
      });
      form.querySelectorAll<HTMLElement>('[data-error-list]').forEach((el) => {
        el.replaceChildren();
      });
    };

    const showErrors = (step: number, errors: { name: string; message: string }[]) => {
      const stepEl = stepEls[step - 1];
      const summary = stepEl.querySelector<HTMLElement>('[data-error-summary]');
      const list = stepEl.querySelector<HTMLElement>('[data-error-list]');

      stepEl.querySelectorAll<HTMLElement>('[data-error-for]').forEach((el) => {
        clearError(el.dataset.errorFor as string);
      });

      if (!errors.length) {
        if (summary) summary.hidden = true;
        return;
      }

      errors.forEach((error) => setError(error.name, error.message));

      if (list) {
        list.replaceChildren();
        errors.forEach((error) => {
          const li = document.createElement('li');
          const link = document.createElement('a');
          link.href = `#${field(error.name)?.id || ''}`;
          link.textContent = error.message;
          link.addEventListener('click', (event) => {
            event.preventDefault();
            field(error.name)?.focus();
          });
          li.appendChild(link);
          list.appendChild(li);
        });
      }
      if (summary) {
        summary.hidden = false;
        summary.focus();
      }
    };

    // --- review ---
    const renderReview = () => {
      if (!reviewBody) return;
      const stops = stopList
        ? Array.from(stopList.querySelectorAll<HTMLInputElement>('input'))
            .map((i) => i.value.trim())
            .filter(Boolean)
        : [];

      const groups: { title: string; step: number; wide?: boolean; rows: [string, string][] }[] = [
        {
          title: 'Journey',
          step: 1,
          rows: [
            ['Pickup', value('pickup')],
            ['Destination', value('destination')],
            ['Stops', stops.length ? stops.join(' → ') : '—'],
            ['Outbound', [value('pickup_date'), value('pickup_time')].filter(Boolean).join(' at ')],
            [
              'Return',
              value('return_journey') === 'yes'
                ? [value('return_date'), value('return_time')].filter(Boolean).join(' at ')
                : 'No return journey',
            ],
          ],
        },
        {
          title: 'Passengers',
          step: 2,
          rows: [
            ['Passengers', value('passengers')],
            [
              'Luggage',
              [labelFor('luggage'), value('luggage_cases') ? `${value('luggage_cases')} large cases` : '', value('luggage_other')]
                .filter(Boolean)
                .join(' · '),
            ],
          ],
        },
        {
          title: 'Vehicle',
          step: 3,
          rows: [
            ['Service level', labelFor('service_level')],
            ['Vehicle preference', labelFor('vehicle_category')],
            [
              'Preferred vehicle',
              value('preferred_vehicle') ? preferredVehicleLabel() : 'No specific preference',
            ],
            ['Journey purpose', value('journey_purpose') ? labelFor('journey_purpose') : '—'],
          ],
        },
        {
          title: 'Contact',
          step: 2,
          rows: [
            ['Name', value('full_name')],
            ['Organisation', value('organisation') || '—'],
            ['Email', value('email')],
            ['Number', value('contact_number')],
            ['Preferred contact', labelFor('preferred_contact_method')],
          ],
        },
        {
          title: 'Additional information',
          step: 3,
          wide: true,
          rows: [
            ['Notes', value('additional_info') || '—'],
            ['Found us via', value('referral_source') ? labelFor('referral_source') : '—'],
          ],
        },
      ];

      // Built as DOM nodes, never as an HTML string: every customer value goes
      // in through textContent, so it cannot be interpreted as markup.
      const blocks = groups.map((group) => {
        const block = document.createElement('div');
        block.className = 'review__block' + (group.wide ? ' review__block--wide' : '');

        const head = document.createElement('div');
        head.className = 'review__head';

        const heading = document.createElement('h4');
        heading.textContent = group.title;
        head.appendChild(heading);

        const edit = document.createElement('button');
        edit.type = 'button';
        edit.className = 'review__edit';
        edit.dataset.editStep = String(group.step);
        edit.textContent = 'Edit';
        head.appendChild(edit);

        block.appendChild(head);

        const dl = document.createElement('dl');
        for (const [label, val] of group.rows) {
          const dt = document.createElement('dt');
          dt.textContent = label;
          const dd = document.createElement('dd');
          dd.textContent = val || '—';
          dl.appendChild(dt);
          dl.appendChild(dd);
        }
        block.appendChild(dl);

        return block;
      });

      reviewBody.replaceChildren(...blocks);
    };

    reviewBody?.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLElement>('[data-edit-step]');
      if (!button) return;
      showStep(Number(button.dataset.editStep));
    });

    /**
     * Brings the newly shown step to the top of the viewport. Scrolling the
     * whole form instead used to leave the step's own action bar below the
     * fold, which read as an unclickable button.
     */
    const scrollToActiveStep = () => {
      const step = stepEls[current - 1];
      (step ?? root).scrollIntoView({ behavior: 'smooth', block: 'start' });
    };

    // --- navigation ---
    root.querySelectorAll('[data-next]').forEach((button) => {
      button.addEventListener('click', () => {
        const errors = validateStep(current);
        showErrors(current, errors);
        if (errors.length) return;
        showStep(current + 1);
        scrollToActiveStep();
      });
    });

    root.querySelectorAll('[data-back]').forEach((button) => {
      button.addEventListener('click', () => {
        showStep(current - 1);
        scrollToActiveStep();
      });
    });

    // --- submission ---
    const successPanel = root.querySelector<HTMLElement>('[data-result-success]');
    const errorPanel = root.querySelector<HTMLElement>('[data-result-error]');
    const whatsappBase = (root.dataset.whatsappHref ?? '').split('?')[0];
    const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const getAccessKey = () => (form.dataset.accessKey ?? '').trim();
    let sending = false;

    /**
     * Human-readable labels so the WMC inbox receives a scannable email rather
     * than raw field keys.
     */
    const buildPayload = () => {
      const data = new FormData();
      const stops = stopList
        ? Array.from(stopList.querySelectorAll<HTMLInputElement>('input'))
            .map((i) => i.value.trim())
            .filter(Boolean)
        : [];

      const add = (label: string, val: string) => {
        if (val) data.append(label, val);
      };

      data.append('access_key', getAccessKey());
      data.append('subject', 'New WMC Quote Request');
      data.append('from_name', 'West Midlands Coaches Website');
      const honeypot = form.querySelector<HTMLInputElement>('input[name="botcheck"]');
      data.append('botcheck', honeypot?.checked ? 'true' : '');
      // Web3Forms uses the field named `email` as the reply-to address.
      data.append('email', value('email'));

      add('Quote Type', 'Journey / Quote Request');

      add('Pickup', value('pickup'));
      add('Destination', value('destination'));
      add('Pickup Date', value('pickup_date'));
      add('Pickup Time', value('pickup_time'));

      const isReturn = value('return_journey') === 'yes';
      add('Return Journey', isReturn ? 'Yes' : 'No');
      if (isReturn) {
        add('Return Date', value('return_date'));
        add('Return Time', value('return_time'));
      }

      if (stops.length) {
        add('Additional Stops', stops.map((s, i) => `${i + 1}. ${s}`).join('\n'));
      }

      add('Full Name', value('full_name'));
      add('Contact Number', value('contact_number'));
      add('Email Address', value('email'));
      add('Organisation', value('organisation'));
      add('Passengers', value('passengers'));

      add('Luggage', labelFor('luggage'));
      add('Approximate Large Cases', value('luggage_cases'));
      add('Other / Bulky Luggage', value('luggage_other'));

      add('Service Level', labelFor('service_level'));
      add('Vehicle Preference', labelFor('vehicle_category'));
      if (value('preferred_vehicle')) add('Preferred WMC Vehicle', preferredVehicleLabel());
      if (value('journey_purpose')) add('Journey Purpose', labelFor('journey_purpose'));

      add('Additional Information', value('additional_info'));
      if (value('referral_source')) add('Referral Source', labelFor('referral_source'));
      add('Preferred Contact Method', labelFor('preferred_contact_method'));
      add('Source Page', window.location.pathname);

      return data;
    };

    /**
     * Operational summary only. The full enquiry — email address, accessibility
     * notes, free-text and referral source — reaches WMC through Web3Forms, so
     * none of it belongs in a URL.
     */
    const buildWhatsAppHref = () => {
      const stops = stopList
        ? Array.from(stopList.querySelectorAll<HTMLInputElement>('input'))
            .map((i) => i.value.trim())
            .filter(Boolean)
        : [];

      const lines: string[] = ['WMC Quote Request', ''];
      const add = (label: string, val: string) => {
        if (val) lines.push(`${label}: ${val}`);
      };

      add('Name', value('full_name'));

      const pickup = value('pickup');
      const destination = value('destination');
      if (pickup && destination) lines.push(`Journey: ${pickup} → ${destination}`);

      if (stops.length) lines.push(`Stops: ${stops.join(' → ')}`);

      add('Pickup Date', value('pickup_date'));
      add('Pickup Time', value('pickup_time'));

      const isReturn = value('return_journey') === 'yes';
      add('Return Journey', isReturn ? 'Yes' : 'No');
      if (isReturn) {
        add('Return Date', value('return_date'));
        add('Return Time', value('return_time'));
      }

      add('Passengers', value('passengers'));
      add('Service Level', labelFor('service_level'));
      add('Vehicle Preference', labelFor('vehicle_category'));
      if (value('preferred_vehicle')) add('Preferred WMC Vehicle', preferredVehicleLabel());
      if (value('journey_purpose')) add('Journey Purpose', labelFor('journey_purpose'));

      lines.push('', 'I have submitted the full journey details through the WMC website.');

      return `${whatsappBase}?text=${encodeURIComponent(lines.join('\n'))}`;
    };

    const setSending = (state: boolean) => {
      sending = state;
      if (!submitButton) return;
      submitButton.disabled = state;
      submitButton.setAttribute('aria-busy', String(state));
      submitButton.textContent = state ? 'Sending…' : 'Send Quote Request';
    };

    const showResult = (panel: HTMLElement | null, other: HTMLElement | null) => {
      if (other) other.hidden = true;
      if (!panel) return;
      panel.hidden = false;
      panel.focus();
      panel.scrollIntoView({ behavior: 'smooth', block: 'center' });
    };

    root.querySelector('[data-retry]')?.addEventListener('click', () => {
      if (errorPanel) errorPanel.hidden = true;
      showStep(3);
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (sending) return;

      clearAllErrors();
      const all = [1, 2, 3].flatMap((step) => validateStep(step).map((e) => ({ ...e, step })));
      if (all.length) {
        const first = all[0].step;
        showStep(first);
        showErrors(first, all.filter((e) => e.step === first));
        return;
      }

      if (!getAccessKey()) {
        // Without a key nothing can be delivered, so never claim success.
        showResult(errorPanel, successPanel);
        return;
      }

      setSending(true);

      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          body: buildPayload(),
        });
        const result = await response.json().catch(() => null);
        const delivered = response.ok && result?.success === true;

        if (!delivered) {
          showResult(errorPanel, successPanel);
          return;
        }

        // Built from the submitted values, before anything is cleared. This
        // runs only after Web3Forms has confirmed delivery, so a rejected
        // submission can never hand off to WhatsApp.
        const handOffToWhatsApp = value('preferred_contact_method') === 'whatsapp';
        const whatsappHref = handOffToWhatsApp ? buildWhatsAppHref() : '';

        // Only now is it safe to retire the draft and close the form.
        try {
          sessionStorage.removeItem(STORAGE_KEY);
        } catch {
          /* storage unavailable */
        }

        form.hidden = true;
        showResult(successPanel, errorPanel);

        if (handOffToWhatsApp && whatsappHref) {
          // The success panel is already rendered, so the customer sees a
          // confirmed outcome whether or not the handoff completes.
          // location.assign rather than window.open: after awaiting the
          // submission this is no longer a trusted user gesture, and a popup
          // would be blocked. `sending` deliberately stays true so the form
          // cannot be resubmitted while the browser leaves the page.
          window.location.assign(whatsappHref);
          return;
        }
      } catch {
        showResult(errorPanel, successPanel);
      } finally {
        if (!form.hidden) setSending(false);
        else sending = false;
      }
    });

    const restoreDraft = () => {
      try {
        const raw = sessionStorage.getItem(STORAGE_KEY);
        if (!raw) return;
        const data = JSON.parse(raw) as Record<string, string>;
        const stopKeys = Object.keys(data).filter((k) => /^stop_\d+$/.test(k));
        stopKeys.forEach(() => root.querySelector<HTMLButtonElement>('[data-add-stop]')?.click());
        Object.entries(data).forEach(([name, val]) => {
          const radios = form.querySelectorAll<HTMLInputElement>(`input[type="radio"][name="${name}"]`);
          if (radios.length) {
            radios.forEach((r) => (r.checked = r.value === val));
            return;
          }
          const el = field(name);
          if (el) el.value = val;
        });
      } catch {
        /* ignore malformed drafts */
      }
    };

    // --- URL context ---
    const applyUrlContext = () => {
      const params = new URLSearchParams(window.location.search);
      const fleet = params.get('fleet');
      const allowedFleet = ['car', 'minibus', 'coach'];
      if (fleet && allowedFleet.includes(fleet)) {
        const categories = Array.from(
          form.querySelectorAll<HTMLInputElement>('input[name="vehicle_category"]'),
        );
        const radio = categories.find((r) => r.value === fleet);
        if (radio) {
          categories.forEach((r) => (r.checked = false));
          radio.checked = true;
        }
      }

      // ?service= carries either a journey purpose or a service level.
      const service = params.get('service');
      const purpose = field('journey_purpose');
      if (service && purpose instanceof HTMLSelectElement) {
        const match = Array.from(purpose.options).find((o) => o.value === service);
        if (match) purpose.value = match.value;
      }

      if (service) {
        const levels = Array.from(
          form.querySelectorAll<HTMLInputElement>('input[name="service_level"]'),
        );
        const levelRadio = levels.find((r) => r.value === service);
        if (levelRadio) {
          levels.forEach((r) => (r.checked = false));
          levelRadio.checked = true;
        }
      }

    };

    const applyUrlVehicle = () => {
      const vehicle = new URLSearchParams(window.location.search).get('vehicle');
      const preferred = field('preferred_vehicle');
      if (!vehicle || !(preferred instanceof HTMLSelectElement)) return;
      const match = Array.from(preferred.options).find(
        (option) => option.value === vehicle && !option.hidden,
      );
      if (match) preferred.value = match.value;
    };

    restoreDraft();
    applyUrlContext();
    syncConditionals();
    // Re-apply the vehicle from the URL now that filtering has run, so a valid
    // deep link is not cleared by the first filter pass.
    applyUrlVehicle();
    showStep(1, false);
  }
</script>
