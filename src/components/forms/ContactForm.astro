---
import Button from '../ui/Button.astro';
import { contact } from '../../data/navigation';

const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? '';

const enquiryTypes = [
  'General Enquiry',
  'Existing Quote / Enquiry',
  'Corporate / Contract Enquiry',
  'Fleet Question',
  'Website Enquiry',
  'Other',
];
---

<div class="contact-form" data-contact-form>
  <header class="contact-form__head">
    <p class="eyebrow">General enquiry</p>
    <h2 class="text-h4 contact-form__title">Send WMC a message</h2>
    <p class="text-body contact-form__intro">
      For a question about WMC, the fleet or an existing enquiry. For a journey that needs a price,
      use the quotation form instead.
    </p>
  </header>

  <form class="contact-form__form" data-form novalidate data-access-key={accessKey}>
    <!-- Web3Forms honeypot. Real people never see or fill this. -->
    <label class="visually-hidden" aria-hidden="true">
      Leave this field empty
      <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" />
    </label>

    <div class="error-summary" data-error-summary tabindex="-1" hidden>
      <h3 class="error-summary__title">Check these details</h3>
      <ul data-error-list></ul>
    </div>

    <div class="field-row">
      <div class="field">
        <label class="field__label" for="contact_full_name">Full Name <span aria-hidden="true">*</span></label>
        <input class="field__input" id="contact_full_name" name="full_name" type="text" required autocomplete="name" />
        <p class="field__error" data-error-for="full_name" hidden></p>
      </div>
      <div class="field">
        <label class="field__label" for="contact_email">Email <span aria-hidden="true">*</span></label>
        <input class="field__input" id="contact_email" name="email" type="email" required autocomplete="email" inputmode="email" />
        <p class="field__error" data-error-for="email" hidden></p>
      </div>
    </div>

    <div class="field-row">
      <div class="field">
        <label class="field__label" for="contact_number">
          Contact Number <span class="field__optional">Optional</span>
        </label>
        <input class="field__input" id="contact_number" name="contact_number" type="tel" autocomplete="tel" inputmode="tel" />
      </div>
      <div class="field">
        <label class="field__label" for="contact_subject">Enquiry Type <span aria-hidden="true">*</span></label>
        <div class="select-wrap wmc-select">
          <select class="field__input" id="contact_subject" name="subject_type" required>
            <option value="">Select an enquiry type</option>
            {enquiryTypes.map((type) => <option value={type}>{type}</option>)}
          </select>
        </div>
        <p class="field__error" data-error-for="subject_type" hidden></p>
      </div>
    </div>

    <div class="field">
      <label class="field__label" for="contact_message">Message <span aria-hidden="true">*</span></label>
      <textarea class="field__input field__textarea" id="contact_message" name="message" rows="6" required
        placeholder="How can WMC help?"></textarea>
      <p class="field__error" data-error-for="message" hidden></p>
    </div>

    <p class="contact-form__note text-small">
      The information provided will be used to respond to your enquiry.
    </p>

    <div class="contact-form__actions">
      <Button type="submit" variant="primary">Send Enquiry</Button>
    </div>
  </form>

  <!-- Result panels. Shown only after Web3Forms confirms an outcome. -->
  <section class="result result--success" data-result-success role="status" tabindex="-1" hidden>
    <p class="eyebrow">Enquiry</p>
    <h3 class="text-h4 result__title">Enquiry received.</h3>
    <p class="text-body result__copy">
      Thank you. WMC has received your message and will review your enquiry.
    </p>
    <div class="result__actions">
      <Button href="/request-a-quote/" variant="primary">Request a Quote</Button>
      <Button href={contact.whatsappHref} variant="secondary" target="_blank" rel="noopener noreferrer">
        WhatsApp
      </Button>
    </div>
  </section>

  <section class="result result--error" data-result-error role="alert" tabindex="-1" hidden>
    <h3 class="text-h4 result__title">We couldn't send your enquiry.</h3>
    <p class="text-body result__copy">
      Your message has been kept. Please try again, or contact WMC by phone or WhatsApp.
    </p>
    <div class="result__actions">
      <Button type="button" variant="primary" data-retry>Try Again</Button>
      <Button href={contact.phoneHref} variant="secondary">Call {contact.phoneDisplay}</Button>
      <Button href={contact.whatsappHref} variant="secondary">WhatsApp</Button>
    </div>
  </section>
</div>

<style>
  .contact-form {
    border: var(--border-width-hairline) solid var(--color-linen-border);
    border-radius: var(--radius-media);
    background-color: var(--color-warm-white);
    box-shadow: var(--shadow-low);
    overflow: hidden;
  }

  .contact-form__head {
    padding: var(--space-4) var(--space-3);
    border-block-end: var(--border-width-hairline) solid var(--color-linen-border);
    background-color: var(--color-heritage-ivory);
  }

  .contact-form__form {
    padding: var(--space-4) var(--space-3) var(--space-5);
  }

  @media (min-width: 768px) {
    .contact-form__head {
      padding: var(--space-5);
    }

    .contact-form__form {
      padding: var(--space-5);
    }
  }

  .contact-form__title {
    margin: 0 0 var(--space-1);
  }

  .contact-form__intro {
    color: var(--color-slate-taupe);
    margin: 0;
    max-inline-size: 54ch;
  }

  .contact-form__note {
    color: var(--color-slate-taupe);
    margin: 0;
    max-inline-size: 54ch;
  }

  .contact-form__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block-start: var(--space-4);
  }

  .contact-form__actions :global(.wmc-button) {
    min-block-size: 54px;
    padding-inline: var(--space-4);
  }

  @media (max-width: 599px) {
    .contact-form__actions :global(.wmc-button) {
      inline-size: 100%;
    }
  }

  /* --- fields (matches the quotation form's control language) --- */
  .field {
    margin-block-end: var(--space-4);
  }

  .field__label {
    display: block;
    font-size: var(--text-form-label);
    line-height: var(--leading-form-label);
    font-weight: var(--font-weight-semibold);
    color: var(--color-ink);
    margin-block-end: var(--space-1);
  }

  .field__label > span[aria-hidden] {
    color: var(--color-champagne-gold);
  }

  .field__optional {
    font-weight: var(--font-weight-regular);
    color: var(--color-slate-taupe);
    font-size: var(--text-small);
  }

  .field__input {
    inline-size: 100%;
    min-block-size: 54px;
    padding-inline: var(--space-2);
    padding-block: 0;
    font-size: var(--text-form-input);
    line-height: var(--leading-form-input);
    color: var(--color-ink);
    background-color: var(--color-warm-white);
    border: var(--border-width-hairline) solid var(--color-linen-border);
    border-radius: 6px;
    transition: border-color var(--motion-hover) var(--motion-easing-premium),
      box-shadow var(--motion-hover) var(--motion-easing-premium);
  }

  .field__input:hover {
    border-color: var(--color-mist-taupe);
  }

  .field__input:focus-visible {
    outline: none;
    border-color: var(--color-champagne-gold);
    box-shadow: 0 0 0 3px var(--gold-wash);
  }

  .field__textarea {
    min-block-size: 150px;
    padding-block: var(--space-2);
    resize: vertical;
    font-family: inherit;
  }

  .field-row {
    display: grid;
    gap: 0 var(--space-4);
  }

  @media (min-width: 720px) {
    .field-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .select-wrap {
    position: relative;
  }

  .select-wrap select {
    appearance: none;
    padding-inline-end: var(--space-6);
  }

  .select-wrap::after {
    content: '';
    position: absolute;
    inset-inline-end: var(--space-3);
    inset-block-start: 50%;
    inline-size: 9px;
    block-size: 9px;
    margin-block-start: -6px;
    border-inline-end: 2px solid var(--color-slate-taupe);
    border-block-end: 2px solid var(--color-slate-taupe);
    transform: rotate(45deg);
    pointer-events: none;
  }

  /* `display: flex` would otherwise beat the UA rule for [hidden]. */
  .field__error[hidden] {
    display: none;
  }

  .field__error {
    display: flex;
    align-items: flex-start;
    gap: var(--space-1);
    color: var(--color-error-light);
    font-size: var(--text-small);
    line-height: var(--leading-small);
    font-weight: var(--font-weight-semibold);
    margin: var(--space-1) 0 0;
  }

  /* Errors are never signalled by colour alone. */
  .field__error::before {
    content: '!';
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 16px;
    block-size: 16px;
    flex-shrink: 0;
    margin-block-start: 2px;
    border: 1px solid currentColor;
    border-radius: 50%;
    font-size: 11px;
  }

  .field__input[aria-invalid='true'] {
    border-color: var(--color-error-light);
    border-inline-start-width: 3px;
  }

  .error-summary {
    border: var(--border-width-hairline) solid var(--color-error-light);
    border-inline-start-width: 3px;
    border-radius: 6px;
    padding: var(--space-3);
    margin-block-end: var(--space-4);
    background-color: rgb(183 75 75 / 0.05);
  }

  .error-summary__title {
    margin: 0 0 var(--space-1);
    font-size: var(--text-h6);
    line-height: var(--leading-h6);
    color: var(--color-error-light);
  }

  .error-summary ul {
    margin: 0;
    padding-inline-start: var(--space-3);
    color: var(--color-ink);
    font-size: var(--text-small);
    line-height: var(--leading-small);
  }

  .error-summary a {
    color: var(--color-ink);
  }

  /* --- result panels --- */
  .result {
    padding: var(--space-5) var(--space-3);
    animation: result-in 220ms var(--motion-easing-premium);
  }

  @media (min-width: 768px) {
    .result {
      padding: var(--space-5);
    }
  }

  .result--success {
    border-block-start: 3px solid var(--color-success-light);
    background-color: var(--color-heritage-ivory);
  }

  .result--error {
    border-block-start: 3px solid var(--color-error-light);
  }

  .result__title {
    margin: 0 0 var(--space-2);
  }

  .result--error .result__title {
    color: var(--color-error-light);
  }

  .result__copy {
    color: var(--color-slate-taupe);
    margin: 0;
    max-inline-size: 54ch;
  }

  .result__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block-start: var(--space-4);
  }

  @media (max-width: 599px) {
    .result__actions {
      gap: 12px;
    }

    .result__actions :global(.wmc-button) {
      inline-size: 100%;
    }
  }

  @keyframes result-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .result {
      animation: none;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-contact-form]');
  const form = root?.querySelector<HTMLFormElement>('[data-form]');

  if (root && form) {
    const successPanel = root.querySelector<HTMLElement>('[data-result-success]');
    const errorPanel = root.querySelector<HTMLElement>('[data-result-error]');
    const summary = form.querySelector<HTMLElement>('[data-error-summary]');
    const errorList = form.querySelector<HTMLElement>('[data-error-list]');
    const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    let sending = false;

    const field = (name: string) =>
      form.querySelector<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(`[name="${name}"]`);
    const value = (name: string) => field(name)?.value.trim() ?? '';
    const getAccessKey = () => (form.dataset.accessKey ?? '').trim();

    const setError = (name: string, message: string) => {
      const el = field(name);
      const holder = form.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
      if (holder) {
        holder.textContent = message;
        holder.hidden = false;
        holder.id = holder.id || `contact-error-${name}`;
      }
      if (el) {
        el.setAttribute('aria-invalid', 'true');
        if (holder) el.setAttribute('aria-describedby', holder.id);
      }
    };

    const clearErrors = () => {
      form.querySelectorAll<HTMLElement>('[data-error-for]').forEach((holder) => {
        holder.hidden = true;
        holder.textContent = '';
        const el = field(holder.dataset.errorFor as string);
        el?.removeAttribute('aria-invalid');
        el?.removeAttribute('aria-describedby');
      });
      if (summary) summary.hidden = true;
      if (errorList) errorList.innerHTML = '';
    };

    const isEmail = (v: string) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);

    const validate = () => {
      const errors: { name: string; message: string }[] = [];
      if (!value('full_name')) errors.push({ name: 'full_name', message: 'Enter your full name.' });
      if (!value('email')) errors.push({ name: 'email', message: 'Enter your email address.' });
      else if (!isEmail(value('email'))) errors.push({ name: 'email', message: 'Enter a valid email address.' });
      if (!value('subject_type')) errors.push({ name: 'subject_type', message: 'Choose an enquiry type.' });
      if (!value('message')) errors.push({ name: 'message', message: 'Enter a message.' });
      return errors;
    };

    const showErrors = (errors: { name: string; message: string }[]) => {
      clearErrors();
      if (!errors.length) return;

      errors.forEach((error) => setError(error.name, error.message));

      if (errorList) {
        errors.forEach((error) => {
          const li = document.createElement('li');
          const link = document.createElement('a');
          link.href = `#${field(error.name)?.id ?? ''}`;
          link.textContent = error.message;
          link.addEventListener('click', (event) => {
            event.preventDefault();
            field(error.name)?.focus();
          });
          li.appendChild(link);
          errorList.appendChild(li);
        });
      }
      if (summary) {
        summary.hidden = false;
        summary.focus();
      }
    };

    /**
     * Development-only delivery diagnostics. Web3Forms answers a rejected
     * submission with a specific reason (an unrecognised access key, for
     * instance) that the customer-facing error panel deliberately never shows.
     * Only the HTTP status, the success flag and Web3Forms' own message are
     * ever passed here — never a field name, a field value, or the FormData
     * itself, so no enquiry data can reach the console.
     */
    const reportDeliveryFailure = (detail: string) => {
      if (!import.meta.env.DEV) return;
      console.warn(`[WMC contact form] Web3Forms did not accept the submission — ${detail}`);
    };

    const setSending = (state: boolean) => {
      sending = state;
      if (!submitButton) return;
      submitButton.disabled = state;
      submitButton.setAttribute('aria-busy', String(state));
      submitButton.textContent = state ? 'Sending…' : 'Send Enquiry';
    };

    const showResult = (panel: HTMLElement | null, other: HTMLElement | null) => {
      if (other) other.hidden = true;
      if (!panel) return;
      panel.hidden = false;
      panel.focus();
      panel.scrollIntoView({ behavior: 'smooth', block: 'center' });
    };

    /** Readable labels so the WMC inbox receives a scannable email. */
    const buildPayload = () => {
      const data = new FormData();
      const honeypot = form.querySelector<HTMLInputElement>('input[name="botcheck"]');

      data.append('access_key', getAccessKey());
      data.append('subject', 'New WMC General Enquiry');
      data.append('from_name', 'West Midlands Coaches Website');
      data.append('botcheck', honeypot?.checked ? 'true' : '');
      // Web3Forms uses the field named `email` as the reply-to address.
      data.append('email', value('email'));

      data.append('Enquiry Type', 'General Contact Enquiry');
      data.append('Full Name', value('full_name'));
      data.append('Email Address', value('email'));
      if (value('contact_number')) data.append('Contact Number', value('contact_number'));
      data.append('Subject / Enquiry Type', value('subject_type'));
      data.append('Message', value('message'));
      data.append('Source Page', 'Contact');

      return data;
    };

    root.querySelector('[data-retry]')?.addEventListener('click', () => {
      if (errorPanel) errorPanel.hidden = true;
      form.hidden = false;
      field('full_name')?.focus();
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (sending) return;

      const errors = validate();
      showErrors(errors);
      if (errors.length) return;

      if (!getAccessKey()) {
        // Without a key nothing can be delivered, so never claim success.
        reportDeliveryFailure('missing access key: PUBLIC_WEB3FORMS_ACCESS_KEY is empty');
        showResult(errorPanel, successPanel);
        return;
      }

      setSending(true);

      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          body: buildPayload(),
        });
        const result = await response.json().catch(() => null);
        const delivered = response.ok && result?.success === true;

        if (!delivered) {
          reportDeliveryFailure(
            `status ${response.status} · success ${String(result?.success)} · ${
              result?.message ?? 'no message returned'
            }`,
          );
          showResult(errorPanel, successPanel);
          return;
        }

        form.hidden = true;
        showResult(successPanel, errorPanel);
      } catch {
        showResult(errorPanel, successPanel);
      } finally {
        if (!form.hidden) setSending(false);
        else sending = false;
      }
    });
  }
</script>
