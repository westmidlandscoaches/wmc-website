---
import Button from '../ui/Button.astro';
import { primaryNav, primaryCta } from '../../data/navigation';
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__brand" href="/">
      <span class="site-header__wordmark">West Midlands Coaches</span>
    </a>

    <nav class="site-header__nav" aria-label="Primary">
      <ul class="site-header__nav-list">
        {primaryNav.map((item) => (
          <li>
            <a class="text-navigation site-header__nav-link" href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__cta">
      <Button href={primaryCta.href} variant="primary">{primaryCta.label}</Button>
    </div>

    <details class="site-header__toggle">
      <summary class="site-header__toggle-summary">
        <span class="visually-hidden">Menu</span>
        <span class="site-header__toggle-bar" aria-hidden="true"></span>
      </summary>

      <div class="site-header__mobile">
        <nav aria-label="Mobile">
          <ul class="site-header__mobile-list">
            {primaryNav.map((item) => (
              <li>
                <a class="text-h5 site-header__mobile-link" href={item.href}>{item.label}</a>
              </li>
            ))}
          </ul>
        </nav>
        <div class="site-header__mobile-cta">
          <Button href={primaryCta.href} variant="primary">{primaryCta.label}</Button>
        </div>
      </div>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 100;
    background-color: var(--color-warm-white);
    border-block-end: var(--border-width-hairline) solid var(--color-linen-border);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    max-inline-size: var(--content-max-width);
    margin-inline: auto;
    padding-inline: var(--space-3);
    block-size: 76px;
  }

  @media (min-width: 768px) {
    .site-header__inner {
      padding-inline: var(--space-4);
      block-size: 92px;
    }
  }

  .site-header__brand {
    text-decoration: none;
    color: var(--color-obsidian);
    margin-inline-end: auto;
  }

  .site-header__wordmark {
    font-size: 1.25rem;
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  .site-header__nav {
    display: none;
  }

  .site-header__nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-header__nav-link {
    text-decoration: none;
    color: var(--color-ink);
    padding-block: var(--space-1);
  }

  .site-header__nav-link:hover {
    color: var(--color-obsidian);
  }

  .site-header__cta {
    display: none;
  }

  .site-header__toggle-summary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: var(--touch-target-min);
    block-size: var(--touch-target-min);
    background: transparent;
    border: var(--border-width-hairline) solid var(--color-linen-border);
    border-radius: var(--radius-control);
    cursor: pointer;
    list-style: none;
  }

  .site-header__toggle-summary::-webkit-details-marker {
    display: none;
  }

  .site-header__toggle-bar,
  .site-header__toggle-bar::before,
  .site-header__toggle-bar::after {
    display: block;
    inline-size: 20px;
    block-size: 2px;
    background-color: var(--color-obsidian);
    position: relative;
  }

  .site-header__toggle-bar::before,
  .site-header__toggle-bar::after {
    content: '';
    position: absolute;
    inset-inline-start: 0;
  }

  .site-header__toggle-bar::before {
    inset-block-start: -6px;
  }

  .site-header__toggle-bar::after {
    inset-block-start: 6px;
  }

  .site-header__mobile {
    position: absolute;
    inset-inline: 0;
    inset-block-start: 100%;
    border-block-start: var(--border-width-hairline) solid var(--color-linen-border);
    background-color: var(--color-warm-white);
    padding: var(--space-3);
  }

  .site-header__mobile-list {
    list-style: none;
    margin: 0 0 var(--space-3);
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .site-header__mobile-link {
    text-decoration: none;
    color: var(--color-ink);
    display: block;
    padding-block: var(--space-2);
    min-block-size: var(--touch-target-min);
  }

  .site-header__mobile-cta :global(.wmc-button) {
    inline-size: 100%;
  }

  @media (min-width: 1024px) {
    .site-header__nav {
      display: block;
    }

    .site-header__cta {
      display: inline-flex;
    }

    .site-header__toggle {
      display: none;
    }
  }
</style>

