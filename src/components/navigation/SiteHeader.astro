---
import { Image } from 'astro:assets';
import Button from '../ui/Button.astro';
import { primaryNav, primaryCta, contact } from '../../data/navigation';
import wmcCompactMark from '../../assets/brand/WMC_Compact_Mark_Premium.webp';

const path = Astro.url.pathname;

/** A link is current when it matches the page, ignoring hash-only entries. */
const isCurrent = (href: string) => !href.includes('#') && path === href;
---

<header class="site-header" data-scrolled="false" id="site-header">
  <div class="site-header__inner">
    <a class="site-header__brand" href="/" aria-label="West Midlands Coaches home">
      <span class="site-header__mark">
        <Image
          src={wmcCompactMark}
          alt="West Midlands Coaches"
          widths={[420, 620, 840]}
          sizes="420px"
          loading="eager"
          class="site-header__mark-image"
        />
      </span>
    </a>

    <nav class="site-header__nav" aria-label="Primary">
      <ul class="site-header__nav-list">
        {primaryNav.map((item) => (
          <li>
            <a
              class="text-navigation site-header__nav-link"
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__cta">
      <Button href={primaryCta.href} variant="primary" tone="dark">{primaryCta.label}</Button>
    </div>

    <button
      type="button"
      class="site-header__toggle"
      aria-expanded="false"
      aria-controls="site-menu"
      data-menu-toggle
    >
      <span class="visually-hidden">Open menu</span>
      <span class="site-header__icon" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </span>
    </button>
  </div>
</header>

<!-- Off-canvas navigation. Hidden entirely until the toggle script runs. -->
<div class="site-menu" id="site-menu" data-menu hidden>
  <div class="site-menu__scrim" data-menu-scrim></div>

  <div class="site-menu__panel" role="dialog" aria-modal="true" aria-label="Site navigation">
    <div class="site-menu__head">
      <span class="site-menu__mark">
        <Image
          src={wmcCompactMark}
          alt="West Midlands Coaches"
          widths={[420, 620, 840]}
          sizes="420px"
          loading="eager"
          class="site-header__mark-image"
        />
      </span>
      <button type="button" class="site-menu__close" data-menu-close>
        <span class="visually-hidden">Close menu</span>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
          <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>

    <nav class="site-menu__nav" aria-label="Mobile">
      <ul class="site-menu__list">
        {primaryNav.map((item, index) => (
          <li style={`--row-index:${index}`}>
            <a
              class="site-menu__link"
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              <span>{item.label}</span>
              <span class="site-menu__arrow" aria-hidden="true">&#8594;</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-menu__foot">
      <Button href={primaryCta.href} variant="primary" tone="dark">{primaryCta.label}</Button>
      <div class="site-menu__direct">
        <a class="site-menu__direct-link" href={contact.phoneHref}>Call {contact.phoneDisplay}</a>
        <a
          class="site-menu__direct-link"
          href={contact.whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
        >
          WhatsApp
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 100;
    background-color: var(--color-obsidian);
    border-block-end: var(--border-width-hairline) solid transparent;
    transition: border-color var(--motion-hover) var(--motion-easing-premium),
      box-shadow var(--motion-hover) var(--motion-easing-premium);
  }

  .site-header[data-scrolled='true'] {
    border-block-end-color: var(--color-charcoal-border);
    box-shadow: 0 6px 24px rgb(0 0 0 / 0.28);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    max-inline-size: var(--content-max-width);
    margin-inline: auto;
    padding-inline: 20px;
    block-size: 58px;
  }

  @media (min-width: 768px) {
    .site-header__inner {
      gap: var(--space-4);
      padding-inline: var(--space-4);
      block-size: 64px;
    }
  }

  @media (min-width: 1024px) {
    .site-header__inner {
      block-size: 70px;
    }
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    /* Matches the optical centre of the nav row rather than the box centre. */
    align-self: center;
    min-block-size: var(--touch-target-min);
    text-decoration: none;
    margin-inline-end: auto;
  }

  /*
   * The approved mark is delivered on a 2000x2000 canvas whose outer area is
   * empty alpha. Measured from the asset itself, the glyph occupies 910x411px
   * centred on that canvas: 0.2055 of the canvas height, at an aspect ratio of
   * 2.2141:1. The asset is never altered — the wrapper simply frames the glyph
   * band, so --mark-height is the height the monogram actually renders at and
   * the wrapper is exactly as wide as the glyph, with no phantom transparent
   * padding pushing the logo off the page gutter.
   */
  .site-header__mark {
    --mark-height: 34px;
    display: block;
    flex-shrink: 0;
    block-size: var(--mark-height);
    inline-size: calc(var(--mark-height) * 2.2141);
    overflow: hidden;
    position: relative;
  }

  .site-header__mark-image {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    transform: translate(-50%, -50%);
    inline-size: calc(var(--mark-height) / 0.2055);
    max-inline-size: none;
    block-size: auto;
  }

  @media (min-width: 768px) {
    .site-header__mark {
      --mark-height: 38px;
    }
  }

  @media (min-width: 1024px) {
    .site-header__mark {
      --mark-height: 42px;
    }
  }

  .site-header__nav {
    display: none;
  }

  .site-header__nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-header__nav-link {
    position: relative;
    display: block;
    text-decoration: none;
    color: var(--color-mist-taupe);
    padding-block: var(--space-1);
    transition: color 190ms var(--motion-easing-premium);
  }

  .site-header__nav-link::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    block-size: 1px;
    background-color: var(--color-champagne-gold);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 190ms var(--motion-easing-premium);
  }

  .site-header__nav-link:hover,
  .site-header__nav-link:focus-visible {
    color: var(--color-warm-white);
  }

  .site-header__nav-link:hover::after,
  .site-header__nav-link:focus-visible::after {
    transform: scaleX(1);
  }

  /* Current page keeps a quiet, permanent marker. */
  .site-header__nav-link[aria-current='page'] {
    color: var(--color-warm-white);
  }

  .site-header__nav-link[aria-current='page']::after {
    transform: scaleX(1);
    background-color: var(--gold-rule);
  }

  .site-header__cta {
    display: none;
  }

  .site-header__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: center;
    flex-shrink: 0;
    inline-size: var(--touch-target-min);
    block-size: var(--touch-target-min);
    background: transparent;
    border: var(--border-width-hairline) solid var(--color-charcoal-border);
    border-radius: var(--radius-control);
    cursor: pointer;
  }

  /* Hamburger that morphs into an X. Decorative, so it never takes the click. */
  .site-header__icon {
    position: relative;
    display: block;
    inline-size: 20px;
    block-size: 14px;
    pointer-events: none;
  }

  .site-header__icon span {
    position: absolute;
    inset-inline: 0;
    block-size: 2px;
    background-color: var(--color-warm-white);
    transition: transform 230ms var(--motion-easing-premium),
      opacity 160ms var(--motion-easing-premium);
  }

  .site-header__icon span:nth-child(1) {
    inset-block-start: 0;
  }

  .site-header__icon span:nth-child(2) {
    inset-block-start: 6px;
  }

  .site-header__icon span:nth-child(3) {
    inset-block-start: 12px;
  }

  .site-header__toggle[aria-expanded='true'] .site-header__icon span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }

  .site-header__toggle[aria-expanded='true'] .site-header__icon span:nth-child(2) {
    opacity: 0;
    transform: scaleX(0.4);
  }

  .site-header__toggle[aria-expanded='true'] .site-header__icon span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header__icon span {
      transition: none;
    }
  }

  @media (min-width: 1280px) {
    .site-header__nav-list {
      gap: var(--space-4);
    }
  }

  @media (min-width: 1024px) {
    .site-header__nav {
      display: block;
      margin-inline-end: var(--space-4);
    }

    .site-header__cta {
      display: inline-flex;
    }

    .site-header__toggle {
      display: none;
    }
  }

  /* ---------------------------------------------------------------
     Off-canvas menu
     --------------------------------------------------------------- */
  .site-menu[hidden] {
    display: none;
  }

  .site-menu {
    position: fixed;
    inset: 0;
    z-index: 150;
  }

  /* While closing (or if hiding is ever delayed) the overlay must not keep
     swallowing clicks meant for the page. */
  .site-menu[data-open='false'] {
    pointer-events: none;
  }

  .site-menu__scrim {
    position: absolute;
    inset: 0;
    background-color: rgb(11 10 9 / 0.6);
    opacity: 0;
    transition: opacity 260ms var(--motion-easing-premium);
  }

  .site-menu[data-open='true'] .site-menu__scrim {
    opacity: 1;
  }

  .site-menu[data-closing='true'] .site-menu__scrim {
    opacity: 0;
  }

  .site-menu__panel {
    position: absolute;
    inset-block: 0;
    inset-inline-end: 0;
    inline-size: min(400px, 88vw);
    display: flex;
    flex-direction: column;
    background-color: var(--color-obsidian);
    border-inline-start: var(--border-width-hairline) solid var(--color-charcoal-border);
    padding-block-end: env(safe-area-inset-bottom, 0px);
    opacity: 0;
    transform: translateX(28px);
    transition: opacity 260ms var(--motion-easing-premium),
      transform 260ms var(--motion-easing-premium);
  }

  .site-menu[data-open='true'] .site-menu__panel {
    opacity: 1;
    transform: none;
  }

  /* Exit mirrors the entrance instead of vanishing. */
  .site-menu[data-closing='true'] .site-menu__panel {
    opacity: 0;
    transform: translateX(28px);
  }

  .site-menu__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3);
    block-size: 58px;
    border-block-end: var(--border-width-hairline) solid var(--color-charcoal-border);
  }

  .site-menu__mark {
    --mark-height: 34px;
    display: block;
    block-size: var(--mark-height);
    inline-size: calc(var(--mark-height) * 2.2141);
    overflow: hidden;
    position: relative;
  }

  .site-menu__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: var(--touch-target-min);
    block-size: var(--touch-target-min);
    flex-shrink: 0;
    background: transparent;
    border: var(--border-width-hairline) solid var(--color-charcoal-border);
    border-radius: var(--radius-control);
    color: var(--color-warm-white);
    cursor: pointer;
    transition: border-color var(--motion-hover) var(--motion-easing-premium);
  }

  .site-menu__close:hover {
    border-color: var(--gold-rule);
  }

  .site-menu__nav {
    flex: 1;
    overflow-y: auto;
    padding: var(--space-3) 0;
  }

  .site-menu__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-menu__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-block-size: 56px;
    padding-inline: var(--space-3);
    text-decoration: none;
    color: var(--color-warm-white);
    font-size: var(--text-h6);
    line-height: var(--leading-h6);
    font-weight: var(--font-weight-semibold);
    border-inline-start: 2px solid transparent;
    transition: background-color var(--motion-hover) var(--motion-easing-premium),
      border-color var(--motion-hover) var(--motion-easing-premium);
  }

  .site-menu__arrow {
    color: var(--color-champagne-gold);
    transition: transform var(--motion-hover) var(--motion-easing-premium);
  }

  .site-menu__link:hover,
  .site-menu__link:focus-visible {
    background-color: var(--surface-tint-dark);
  }

  .site-menu__link:hover .site-menu__arrow,
  .site-menu__link:focus-visible .site-menu__arrow {
    transform: translateX(4px);
  }

  .site-menu__link[aria-current='page'] {
    border-inline-start-color: var(--color-champagne-gold);
    background-color: var(--surface-tint-dark);
  }

  /* Light stagger, only while opening. */
  .site-menu[data-open='true'] .site-menu__list li {
    animation: menu-row 260ms var(--motion-easing-premium) both;
    animation-delay: calc(var(--row-index) * 40ms + 60ms);
  }

  @keyframes menu-row {
    from {
      opacity: 0;
      transform: translateX(12px);
    }
  }

  .site-menu__foot {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-3);
    border-block-start: var(--border-width-hairline) solid var(--color-charcoal-border);
  }

  .site-menu__foot :global(.wmc-button) {
    inline-size: 100%;
    min-block-size: 52px;
  }

  .site-menu__direct {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .site-menu__direct-link {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--touch-target-min);
    color: var(--color-mist-taupe);
    font-size: var(--text-small);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
    border-block-end: 1px solid var(--gold-rule);
  }

  .site-menu__direct-link:hover {
    color: var(--color-warm-white);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-menu__scrim,
    .site-menu__panel {
      transition: none;
    }

    .site-menu[data-open='true'] .site-menu__list li {
      animation: none;
    }
  }
</style>

<script>
  const header = document.getElementById('site-header');

  if (header) {
    const sync = () => {
      header.dataset.scrolled = String(window.scrollY > 8);
    };

    sync();
    window.addEventListener('scroll', sync, { passive: true });
  }

  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = menu?.querySelector<HTMLElement>('.site-menu__panel');

  if (menu && toggle && panel) {
    const FOCUSABLE = 'a[href], button:not([disabled])';
    let open = false;

    let closeTimer = 0;

    const setOpen = (next: boolean) => {
      open = next;
      toggle.setAttribute('aria-expanded', String(next));
      toggle.querySelector('.visually-hidden')!.textContent = next ? 'Close menu' : 'Open menu';
      document.body.style.overflow = next ? 'hidden' : '';
      window.clearTimeout(closeTimer);

      if (next) {
        menu.dataset.closing = 'false';
        menu.hidden = false;
        // Forced reflow rather than rAF: the transition still plays, but the
        // open state can never be left pending if frames are throttled.
        void panel.offsetWidth;
        menu.dataset.open = 'true';
        panel.querySelector<HTMLElement>(FOCUSABLE)?.focus();
        return;
      }

      // Play the exit first; only hide once it has finished.
      menu.dataset.closing = 'true';
      menu.dataset.open = 'false';
      toggle.focus();

      const finish = () => {
        if (open) return;
        menu.hidden = true;
        menu.dataset.closing = 'false';
      };

      panel.addEventListener('transitionend', finish, { once: true });
      closeTimer = window.setTimeout(finish, 340);
    };

    toggle.addEventListener('click', () => setOpen(!open));
    menu.querySelector('[data-menu-close]')?.addEventListener('click', () => setOpen(false));
    menu.querySelector('[data-menu-scrim]')?.addEventListener('click', () => setOpen(false));

    // Choosing a destination closes the menu.
    menu.querySelectorAll('a[href]').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (event) => {
      if (!open) return;

      if (event.key === 'Escape') {
        event.preventDefault();
        setOpen(false);
        return;
      }

      if (event.key !== 'Tab') return;

      const focusable = panel.querySelectorAll<HTMLElement>(FOCUSABLE);
      if (focusable.length === 0) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    // Returning to desktop width leaves no orphaned open panel.
    window.matchMedia('(min-width: 1024px)').addEventListener('change', (event) => {
      if (event.matches && open) setOpen(false);
    });
  }
</script>
