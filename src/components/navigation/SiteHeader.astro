---
import { Image } from 'astro:assets';
import Button from '../ui/Button.astro';
import { primaryNav, primaryCta } from '../../data/navigation';
import wmcLogoDark from '../../assets/brand/wmc-logo-dark-use.webp';
---

<header class="site-header" data-scrolled="false" id="site-header">
  <div class="site-header__inner">
    <a class="site-header__brand" href="/">
      <Image
        src={wmcLogoDark}
        alt="West Midlands Coaches"
        widths={[180, 260, 360]}
        sizes="180px"
        loading="eager"
        class="site-header__logo"
      />
    </a>

    <nav class="site-header__nav" aria-label="Primary">
      <ul class="site-header__nav-list">
        {primaryNav.map((item) => (
          <li>
            <a class="text-navigation site-header__nav-link" href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__cta">
      <Button href={primaryCta.href} variant="primary" tone="dark">{primaryCta.label}</Button>
    </div>

    <details class="site-header__toggle">
      <summary class="site-header__toggle-summary">
        <span class="visually-hidden">Menu</span>
        <span class="site-header__toggle-bar" aria-hidden="true"></span>
      </summary>

      <div class="site-header__mobile">
        <nav aria-label="Mobile">
          <ul class="site-header__mobile-list">
            {primaryNav.map((item) => (
              <li>
                <a class="text-h5 site-header__mobile-link" href={item.href}>{item.label}</a>
              </li>
            ))}
          </ul>
        </nav>
        <div class="site-header__mobile-cta">
          <Button href={primaryCta.href} variant="primary" tone="dark">{primaryCta.label}</Button>
        </div>
      </div>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 100;
    /* Obsidian surface: the approved logo is the dark-use variant, so the
       header is built around it rather than recolouring the artwork. */
    background-color: var(--color-obsidian);
    border-block-end: var(--border-width-hairline) solid transparent;
    transition: border-color var(--motion-hover) var(--motion-easing-premium),
      box-shadow var(--motion-hover) var(--motion-easing-premium);
  }

  .site-header[data-scrolled='true'] {
    border-block-end-color: var(--color-charcoal-border);
    box-shadow: 0 6px 20px rgb(0 0 0 / 0.35);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    max-inline-size: var(--content-max-width);
    margin-inline: auto;
    padding-inline: var(--space-3);
    block-size: 76px;
  }

  @media (min-width: 768px) {
    .site-header__inner {
      padding-inline: var(--space-4);
      block-size: 92px;
    }
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--touch-target-min);
    text-decoration: none;
    margin-inline-end: auto;
  }

  .site-header__logo {
    inline-size: 112px;
    block-size: auto;
  }

  @media (min-width: 768px) {
    .site-header__logo {
      inline-size: 140px;
    }
  }

  .site-header__nav {
    display: none;
  }

  .site-header__nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-header__nav-link {
    position: relative;
    display: block;
    text-decoration: none;
    color: var(--color-mist-taupe);
    padding-block: var(--space-1);
    transition: color var(--motion-hover) var(--motion-easing-premium);
  }

  .site-header__nav-link:hover,
  .site-header__nav-link:focus-visible {
    color: var(--color-warm-white);
  }

  .site-header__nav-link::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    block-size: 1px;
    background-color: var(--color-champagne-gold);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 190ms var(--motion-easing-premium);
  }

  .site-header__nav-link:hover::after,
  .site-header__nav-link:focus-visible::after {
    transform: scaleX(1);
  }

  .site-header__cta {
    display: none;
  }

  .site-header__toggle-summary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: var(--touch-target-min);
    block-size: var(--touch-target-min);
    background: transparent;
    border: var(--border-width-hairline) solid var(--color-charcoal-border);
    border-radius: var(--radius-control);
    cursor: pointer;
    list-style: none;
  }

  .site-header__toggle-summary::-webkit-details-marker {
    display: none;
  }

  .site-header__toggle-bar,
  .site-header__toggle-bar::before,
  .site-header__toggle-bar::after {
    display: block;
    inline-size: 20px;
    block-size: 2px;
    background-color: var(--color-warm-white);
    position: relative;
  }

  .site-header__toggle-bar::before,
  .site-header__toggle-bar::after {
    content: '';
    position: absolute;
    inset-inline-start: 0;
  }

  .site-header__toggle-bar::before {
    inset-block-start: -6px;
  }

  .site-header__toggle-bar::after {
    inset-block-start: 6px;
  }

  .site-header__mobile {
    position: absolute;
    inset-inline: 0;
    inset-block-start: 100%;
    border-block-start: var(--border-width-hairline) solid var(--color-charcoal-border);
    background-color: var(--color-obsidian);
    padding: var(--space-4) var(--space-3) var(--space-5);
    box-shadow: 0 14px 32px rgb(0 0 0 / 0.5);
    animation: mobile-nav-in 200ms var(--motion-easing-premium);
  }

  @keyframes mobile-nav-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  .site-header__mobile-list {
    list-style: none;
    margin: 0 0 var(--space-4);
    padding: 0;
    display: flex;
    flex-direction: column;
    border-block-start: var(--border-width-hairline) solid var(--color-charcoal-border);
  }

  .site-header__mobile-list li {
    border-block-end: var(--border-width-hairline) solid var(--color-charcoal-border);
  }

  .site-header__mobile-link {
    position: relative;
    text-decoration: none;
    color: var(--color-warm-white);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-2);
    min-block-size: var(--touch-target-min);
  }

  .site-header__mobile-link::after {
    content: '\2192';
    color: var(--color-champagne-gold);
  }

  .site-header__mobile-cta :global(.wmc-button) {
    inline-size: 100%;
  }

  @media (min-width: 1024px) {
    .site-header__nav {
      display: block;
    }

    .site-header__cta {
      display: inline-flex;
    }

    .site-header__toggle {
      display: none;
    }
  }
</style>


<script>
  const header = document.getElementById('site-header');

  if (header) {
    const sync = () => {
      header.dataset.scrolled = String(window.scrollY > 8);
    };

    sync();
    window.addEventListener('scroll', sync, { passive: true });
  }
</script>
