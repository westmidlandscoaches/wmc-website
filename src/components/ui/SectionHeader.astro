---
export interface Props {
  eyebrow?: string;
  heading: string;
  lead?: string;
}

const { eyebrow, heading, lead } = Astro.props;
---

<header class="section-header">
  {eyebrow && <p class="section-header__eyebrow text-small">{eyebrow}</p>}
  <h2 class="section-header__heading">{heading}</h2>
  {lead && <p class="section-header__lead text-lead">{lead}</p>}
</header>

<style>
  .section-header {
    max-inline-size: 64ch;
    margin-block-end: var(--space-5);
  }

  .section-header__eyebrow {
    color: var(--color-slate-taupe);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: var(--font-weight-semibold);
    margin-block-end: var(--space-1);
  }

  .section-header__heading {
    margin-block: 0;
  }

  .section-header__lead {
    color: var(--color-slate-taupe);
    margin-block-start: var(--space-2);
    margin-block-end: 0;
  }
</style>
