---
export interface Props {
  href?: string;
  variant?: 'primary' | 'secondary';
  /** Use 'dark' when the button sits on an obsidian/night-graphite surface. */
  tone?: 'light' | 'dark';
  type?: 'button' | 'submit' | 'reset';
  [key: string]: unknown;
}

const { href, variant = 'primary', tone = 'light', type = 'button', ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag
  class="wmc-button text-button"
  data-variant={variant}
  data-tone={tone}
  href={href}
  type={href ? undefined : type}
  {...rest}
>
  <slot />
</Tag>

<style>
  .wmc-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-1);
    min-block-size: var(--touch-target-min);
    padding-inline: var(--space-3);
    border-radius: var(--radius-control);
    border: var(--border-width-hairline) solid transparent;
    text-decoration: none;
    cursor: pointer;
    letter-spacing: 0.01em;
    transition: background-color var(--motion-hover) var(--motion-easing-premium),
      border-color var(--motion-hover) var(--motion-easing-premium),
      color var(--motion-hover) var(--motion-easing-premium),
      transform var(--motion-hover) var(--motion-easing-premium);
  }

  @media (hover: hover) and (pointer: fine) {
    .wmc-button:hover {
      transform: translateY(-1px);
    }

    /* Settle back under the cursor while pressing, so the target never
       slides out from under a click. */
    .wmc-button:active {
      transform: none;
    }
  }

  /* Decorative content inside a button never takes the pointer. */
  .wmc-button > :global(svg),
  .wmc-button > :global([aria-hidden='true']) {
    pointer-events: none;
  }

  .wmc-button[data-variant='primary'][data-tone='light'] {
    background-color: var(--color-obsidian);
    color: var(--color-warm-white);
  }

  .wmc-button[data-variant='primary'][data-tone='light']:hover {
    background-color: var(--color-night-graphite);
  }

  .wmc-button[data-variant='secondary'][data-tone='light'] {
    background-color: transparent;
    border-color: var(--color-charcoal-border);
    color: var(--color-ink);
  }

  .wmc-button[data-variant='secondary'][data-tone='light']:hover {
    border-color: var(--color-champagne-gold);
  }

  .wmc-button[data-variant='primary'][data-tone='dark'] {
    background-color: var(--color-champagne-gold);
    color: var(--color-obsidian);
  }

  .wmc-button[data-variant='primary'][data-tone='dark']:hover {
    background-color: var(--color-heritage-ivory);
  }

  .wmc-button[data-variant='secondary'][data-tone='dark'] {
    background-color: transparent;
    border-color: var(--color-charcoal-border);
    color: var(--color-warm-white);
  }

  .wmc-button[data-variant='secondary'][data-tone='dark']:hover {
    border-color: var(--color-champagne-gold);
  }
</style>
