---
/**
 * Entry splash.
 *
 * Structure and animation sequence mirror the CMD SplashIntro system —
 * framed mark tile, tracked eyebrow, wordmark, support line, three signal
 * lines, then a progress track with a travelling lead — rebuilt in WMC
 * identity: Heritage Ivory ground, Ink text, Champagne Gold accent,
 * Source Sans 3.
 *
 * Deliberately opt-in rather than opt-out: the overlay is inert until an
 * inline head script adds `wmc-splash` to <html>, so a browser with no JS —
 * or one where the script fails — never sees it and the page renders
 * normally underneath. It never waits on images and never reports progress
 * it does not have; the track is a timed reveal, not a percentage.
 */
import { Image } from 'astro:assets';
import wmcMonogram from '../../assets/brand/WMC_Monogram.webp';
---

<div class="splash" data-splash aria-hidden="true">
  <span class="splash__ambient splash__ambient--a"></span>
  <span class="splash__ambient splash__ambient--b"></span>

  <div class="splash__brand">
    <span class="splash__mark">
      <Image
        src={wmcMonogram}
        alt=""
        widths={[160, 240, 320]}
        sizes="72px"
        loading="eager"
        class="splash__mark-image"
      />
    </span>

    <p class="splash__eyebrow">West Midlands Coaches Ltd</p>
    <p class="splash__wordmark">WMC</p>
    <p class="splash__support">Transport, Properly Organised.</p>

    <span class="splash__signals">
      <span class="splash__signal splash__signal--one"></span>
      <span class="splash__signal splash__signal--two"></span>
      <span class="splash__signal splash__signal--three"></span>
    </span>

    <span class="splash__loader">
      <span class="splash__loader-fill"></span>
      <span class="splash__loader-lead"></span>
    </span>
  </div>
</div>

<style>
  /*
   * Inert by default. Only the html.wmc-splash class — added by the inline
   * head script below, and only when this session has not seen it — brings
   * the overlay into play.
   */
  .splash {
    display: none;
  }

  :global(html.wmc-splash) .splash {
    --splash-ease: cubic-bezier(0.16, 1, 0.3, 1);
    /* Matches the JS hold, so the progress track finishes as the splash
       leaves rather than stopping short or looping. */
    --splash-hold: 2000ms;
    position: fixed;
    z-index: 9999;
    inset: 0;
    display: grid;
    place-items: center;
    padding: calc(env(safe-area-inset-top, 0px) + var(--space-4)) var(--space-3)
      calc(env(safe-area-inset-bottom, 0px) + var(--space-4));
    overflow: hidden;
    color: var(--color-ink);
    /* Warm White centre falling to Heritage Ivory, with two very quiet gold
       washes on opposing diagonals. */
    background:
      radial-gradient(circle at 50% 44%, rgb(255 255 255 / 0.92), transparent 58%),
      radial-gradient(circle at 16% 18%, rgb(194 156 89 / 0.10), transparent 46%),
      radial-gradient(circle at 84% 82%, rgb(194 156 89 / 0.07), transparent 48%),
      linear-gradient(165deg, var(--color-warm-white) 0%, var(--color-heritage-ivory) 100%);
    opacity: 1;
    transition: opacity 400ms var(--motion-easing-standard);
  }

  @media (min-width: 768px) {
    :global(html.wmc-splash) .splash {
      --splash-hold: 3000ms;
    }
  }

  /* Fading out: pointer input stops immediately, so the overlay can never
     intercept a click even if the transition stalls. */
  :global(html.wmc-splash) .splash[data-closing='true'] {
    opacity: 0;
    pointer-events: none;
  }

  :global(html.wmc-splash) .splash[data-closing='true'] .splash__brand {
    animation: splash-recede 400ms var(--motion-easing-standard) both;
  }

  /* The page underneath must not scroll behind the overlay. Restored the
     moment the class is removed. */
  :global(html.wmc-splash) body {
    overflow: hidden;
  }

  /* Two distant points of gold, on opposing diagonals. */
  .splash__ambient {
    position: absolute;
    inline-size: 8px;
    block-size: 8px;
    border-radius: 50%;
    background-color: var(--color-champagne-gold);
    box-shadow:
      0 0 12px 2px rgb(194 156 89 / 0.45),
      0 0 60px 26px rgb(194 156 89 / 0.10);
    opacity: 0;
  }

  .splash__ambient--a {
    inset-inline-start: 13%;
    inset-block-start: 21%;
  }

  .splash__ambient--b {
    inset-inline-end: 15%;
    inset-block-end: 23%;
  }

  :global(html.wmc-splash) .splash__ambient--a {
    animation: splash-ambient-a 6.4s ease-in-out 260ms infinite;
  }

  :global(html.wmc-splash) .splash__ambient--b {
    animation: splash-ambient-b 5.2s ease-in-out 520ms infinite;
  }

  .splash__brand {
    display: grid;
    justify-items: center;
    gap: 0.85rem;
    text-align: center;
  }

  /* Small framed tile — the mark is never enlarged to hero scale. */
  .splash__mark {
    display: grid;
    place-items: center;
    inline-size: clamp(3.25rem, 9vw, 4.5rem);
    block-size: clamp(3.25rem, 9vw, 4.5rem);
    padding: 0.42rem;
    border: 1px solid var(--gold-rule);
    border-radius: 1rem;
    background-color: rgb(255 255 255 / 0.78);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.6),
      0 0.6rem 1.6rem rgb(11 10 9 / 0.10);
    opacity: 0;
  }

  @supports (backdrop-filter: blur(6px)) {
    .splash__mark {
      backdrop-filter: blur(6px);
    }
  }

  .splash__mark-image {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: contain;
  }

  .splash__eyebrow {
    margin: 0.15rem 0 0;
    color: var(--color-slate-taupe);
    font-size: clamp(0.6rem, 1.5vw, 0.68rem);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.26em;
    text-transform: uppercase;
    opacity: 0;
  }

  .splash__wordmark {
    margin: 0;
    color: var(--color-obsidian);
    font-size: clamp(1.95rem, 3.2vw, 3.4rem);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.06em;
    line-height: 1.05;
    opacity: 0;
  }

  .splash__support {
    max-inline-size: 84vw;
    margin: 0;
    color: var(--color-slate-taupe);
    font-size: clamp(0.8rem, 2vw, 0.95rem);
    text-wrap: balance;
    opacity: 0;
  }

  /* Three signal lines of different lengths. */
  .splash__signals {
    display: grid;
    justify-items: center;
    gap: 0.35rem;
    margin-block-start: 0.5rem;
  }

  .splash__signal {
    block-size: 1px;
    border-radius: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      var(--color-mist-taupe) 22%,
      var(--color-champagne-gold) 50%,
      var(--color-mist-taupe) 78%,
      transparent 100%
    );
    background-size: 220% 100%;
    background-position: 120% 0;
    opacity: 0;
    transform: scaleX(0.2);
  }

  .splash__signal--one {
    inline-size: clamp(6rem, 17vw, 9rem);
  }

  .splash__signal--two {
    inline-size: clamp(3.4rem, 10vw, 5.25rem);
  }

  .splash__signal--three {
    inline-size: clamp(4.6rem, 13vw, 7rem);
  }

  /* Separate, longer progress track. */
  .splash__loader {
    position: relative;
    inline-size: min(62vw, 200px);
    block-size: 2px;
    margin-block-start: 0.9rem;
    border-radius: 2px;
    background-color: var(--color-linen-border);
    overflow: hidden;
  }

  .splash__loader-fill {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    transform-origin: left center;
    transform: scaleX(0.02);
    background: linear-gradient(
      90deg,
      var(--gold-rule-strong) 0%,
      var(--color-champagne-gold) 100%
    );
  }

  .splash__loader-fill::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgb(255 255 255 / 0.46) 50%,
      transparent 100%
    );
    background-size: 34% 100%;
    background-repeat: no-repeat;
    background-position: -40% 0;
    opacity: 0.65;
  }

  .splash__loader-lead {
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 50%;
    inline-size: 100%;
    block-size: 0;
    transform: translateX(2%);
  }

  .splash__loader-lead::before {
    content: '';
    position: absolute;
    inset-inline-start: -3px;
    inset-block-start: -3px;
    inline-size: 6px;
    block-size: 6px;
    border-radius: 50%;
    background-color: var(--color-champagne-gold);
    box-shadow: 0 0 6px 1px rgb(194 156 89 / 0.45);
  }

  /* --- sequence: tile, eyebrow, wordmark, support, signals, progress --- */
  :global(html.wmc-splash) .splash__mark {
    animation: splash-mark 520ms var(--splash-ease) 120ms both;
  }

  :global(html.wmc-splash) .splash__eyebrow {
    animation: splash-rise 430ms var(--splash-ease) 320ms both;
  }

  :global(html.wmc-splash) .splash__wordmark {
    animation: splash-word 550ms var(--splash-ease) 500ms both;
  }

  :global(html.wmc-splash) .splash__support {
    animation: splash-rise 550ms var(--splash-ease) 700ms both;
  }

  :global(html.wmc-splash) .splash__signal {
    animation:
      splash-signal 620ms var(--splash-ease) both,
      splash-sweep 1500ms var(--motion-easing-standard) infinite;
  }

  :global(html.wmc-splash) .splash__signal--one {
    animation-delay: 860ms, 1040ms;
  }

  :global(html.wmc-splash) .splash__signal--two {
    animation-delay: 960ms, 1180ms;
  }

  :global(html.wmc-splash) .splash__signal--three {
    animation-delay: 1060ms, 1320ms;
  }

  /* Runs the length of the hold and finishes filled — a timed reveal, never
     a claim about how much has loaded. */
  :global(html.wmc-splash) .splash__loader-fill {
    animation:
      splash-progress var(--splash-hold) var(--splash-ease) 160ms both,
      splash-progress-sweep 1600ms ease-in-out 400ms infinite;
  }

  :global(html.wmc-splash) .splash__loader-lead {
    animation: splash-progress-lead var(--splash-hold) var(--splash-ease) 160ms both;
  }

  @keyframes splash-mark {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.92);
      filter: blur(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
      filter: blur(0);
    }
  }

  @keyframes splash-rise {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes splash-word {
    from {
      opacity: 0;
      transform: translateY(10px);
      clip-path: inset(0 0 42% 0);
    }
    to {
      opacity: 1;
      transform: translateY(0);
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes splash-signal {
    from {
      opacity: 0;
      transform: scaleX(0.2);
    }
    to {
      opacity: 0.9;
      transform: scaleX(1);
    }
  }

  @keyframes splash-sweep {
    from {
      background-position: 120% 0;
    }
    to {
      background-position: -120% 0;
    }
  }

  @keyframes splash-progress {
    0% {
      transform: scaleX(0.02);
    }
    28% {
      transform: scaleX(0.42);
    }
    62% {
      transform: scaleX(0.74);
    }
    100% {
      transform: scaleX(1);
    }
  }

  @keyframes splash-progress-lead {
    0% {
      transform: translateX(2%);
    }
    28% {
      transform: translateX(42%);
    }
    62% {
      transform: translateX(74%);
    }
    100% {
      transform: translateX(100%);
    }
  }

  @keyframes splash-progress-sweep {
    0% {
      background-position: -40% 0;
    }
    100% {
      background-position: 140% 0;
    }
  }

  @keyframes splash-ambient-a {
    0%,
    100% {
      opacity: 0.32;
      transform: translate3d(0, 0, 0);
    }
    50% {
      opacity: 0.72;
      transform: translate3d(4px, -6px, 0);
    }
  }

  @keyframes splash-ambient-b {
    0%,
    100% {
      opacity: 0.28;
      transform: translate3d(0, 0, 0);
    }
    50% {
      opacity: 0.62;
      transform: translate3d(-5px, 4px, 0);
    }
  }

  @keyframes splash-recede {
    from {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
    to {
      opacity: 0;
      transform: translateY(-4px) scale(0.985);
    }
  }

  /* Reduced motion: the composition is simply present, and the overlay
     leaves at once rather than animating. */
  @media (prefers-reduced-motion: reduce) {
    :global(html.wmc-splash) .splash {
      transition-duration: 1ms;
    }

    :global(html.wmc-splash) .splash__ambient,
    :global(html.wmc-splash) .splash__mark,
    :global(html.wmc-splash) .splash__eyebrow,
    :global(html.wmc-splash) .splash__wordmark,
    :global(html.wmc-splash) .splash__support,
    :global(html.wmc-splash) .splash__signal,
    :global(html.wmc-splash) .splash__loader-fill,
    :global(html.wmc-splash) .splash__loader-lead,
    :global(html.wmc-splash) .splash[data-closing='true'] .splash__brand {
      animation: none;
      opacity: 1;
      transform: none;
      filter: none;
    }

    :global(html.wmc-splash) .splash__loader-fill {
      transform: scaleX(1);
    }
  }
</style>

<script is:inline>
  /*
   * Runs before first paint so the overlay is in place with no flash of the
   * page behind it. Kept tiny and dependency-free on purpose: everything it
   * touches is wrapped, so a blocked sessionStorage cannot stop the page.
   */
  (function () {
    try {
      if (sessionStorage.getItem('wmc-splash-seen') === '1') return;
      sessionStorage.setItem('wmc-splash-seen', '1');
    } catch (e) {
      // Storage unavailable (private mode, blocked cookies): show nothing
      // rather than risk showing the splash on every navigation.
      return;
    }
    document.documentElement.classList.add('wmc-splash');
  })();
</script>

<script>
  const root = document.documentElement;

  if (root.classList.contains('wmc-splash')) {
    const splash = document.querySelector<HTMLElement>('[data-splash]');

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const desktop = window.matchMedia('(min-width: 768px)').matches;
    const hold = reduced ? 0 : desktop ? 3000 : 2000;
    const fade = reduced ? 1 : 400;

    let done = false;
    const finish = () => {
      if (done) return;
      done = true;
      // Removing the class also restores body scrolling.
      root.classList.remove('wmc-splash');
      splash?.remove();
    };

    const close = () => {
      if (!splash) return finish();
      splash.dataset.closing = 'true';
      // Remove on transitionend, with a timer as the authority so a paused or
      // skipped transition can never leave the overlay on screen.
      splash.addEventListener('transitionend', finish, { once: true });
      window.setTimeout(finish, fade + 200);
    };

    window.setTimeout(close, hold);
    // Last-resort failsafe, independent of every timer above.
    window.setTimeout(finish, hold + 2000);
  }
</script>
