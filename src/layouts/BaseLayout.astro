---
import Seo from '../components/layout/Seo.astro';
import SkipLink from '../components/layout/SkipLink.astro';
import SiteHeader from '../components/navigation/SiteHeader.astro';
import SiteFooter from '../components/navigation/SiteFooter.astro';
import type { SeoProps } from '../lib/seo';
import '../styles/global.css';

type Props = SeoProps;

const { title, description, path, ogImage, noindex } = Astro.props;
---

<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <Seo title={title} description={description} path={path} ogImage={ogImage} noindex={noindex}>
      <slot name="structured-data" />
    </Seo>
  </head>
  <body>
    <SkipLink />
    <SiteHeader />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
