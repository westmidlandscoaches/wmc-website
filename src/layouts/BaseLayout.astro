---
import Seo from '../components/layout/Seo.astro';
import SkipLink from '../components/layout/SkipLink.astro';
import SplashScreen from '../components/layout/SplashScreen.astro';
import SiteHeader from '../components/navigation/SiteHeader.astro';
import SiteFooter from '../components/navigation/SiteFooter.astro';
import FloatingContact from '../components/navigation/FloatingContact.astro';
import type { SeoProps } from '../lib/seo';
import '../styles/global.css';

type Props = SeoProps & {
  /** Lets a future page (e.g. the quote form) suppress the floating control. */
  floatingContact?: boolean;
};

const { title, description, path, ogImage, noindex, floatingContact = true } = Astro.props;
---

<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <Seo title={title} description={description} path={path} ogImage={ogImage} noindex={noindex}>
      <slot name="structured-data" />
    </Seo>
    <script is:inline>
      // Opt into reveal start-states only when we can guarantee the reveal
      // runs. Without JS (or without IntersectionObserver) the class is never
      // added and every element stays visible.
      if ('IntersectionObserver' in window) {
        document.documentElement.classList.add('js-reveal');
      }
    </script>
  </head>
  <body>
    <SplashScreen />
    <SkipLink />
    <SiteHeader />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    {floatingContact && <FloatingContact />}

    <script>
      const targets = document.querySelectorAll('[data-reveal], [data-journey-line]');

      if (targets.length && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-revealed');
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
        );

        for (const target of targets) observer.observe(target);

        // Safety net: anything still hidden after load is revealed anyway, so
        // a missed observer callback can never leave content invisible.
        window.addEventListener('load', () => {
          window.setTimeout(() => {
            for (const target of targets) target.classList.add('is-revealed');
          }, 1200);
        });
      }
    </script>
  </body>
</html>
